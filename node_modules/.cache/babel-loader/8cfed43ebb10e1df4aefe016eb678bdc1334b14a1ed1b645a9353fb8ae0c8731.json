{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'SearchResults',\n  data() {\n    return {\n      attractions: [],\n      searchQuery: this.$route.query.q || ''\n    };\n  },\n  created() {\n    this.fetchAttractions();\n  },\n  methods: {\n    async fetchAttractions() {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/attractions/');\n        this.attractions = response.data;\n      } catch (error) {\n        console.error('获取景点失败:', error);\n      }\n    }\n  },\n  computed: {\n    filteredAttractions() {\n      return this.attractions.filter(attraction => attraction.name.includes(this.searchQuery));\n    }\n  },\n  watch: {\n    '$route.query.q': function (newQuery) {\n      this.searchQuery = newQuery;\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","attractions","searchQuery","$route","query","q","created","fetchAttractions","methods","response","get","error","console","computed","filteredAttractions","filter","attraction","includes","watch","$route.query.q","newQuery"],"sources":["src/components/SearchResults.vue"],"sourcesContent":["<template>\r\n  <div class=\"search-results\">\r\n    <h1>搜索结果</h1>\r\n    <ul>\r\n      <li v-for=\"attraction in filteredAttractions\" :key=\"attraction.id\">\r\n        <router-link :to=\"`/attractions/${attraction.id}`\">\r\n          <h3>{{ attraction.name }}</h3>\r\n        </router-link>\r\n        <p>{{ attraction.description }}</p>\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'SearchResults',\r\n  data() {\r\n    return {\r\n      attractions: [],\r\n      searchQuery: this.$route.query.q || ''\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAttractions();\r\n  },\r\n  methods: {\r\n    async fetchAttractions() {\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/attractions/');\r\n        this.attractions = response.data;\r\n      } catch (error) {\r\n        console.error('获取景点失败:', error);\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    filteredAttractions() {\r\n      return this.attractions.filter(attraction =>\r\n        attraction.name.includes(this.searchQuery)\r\n      );\r\n    }\r\n  },\r\n  watch: {\r\n    '$route.query.q': function(newQuery) {\r\n      this.searchQuery = newQuery;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.search-results {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.search-results ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.search-results li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n\r\n.search-results h3 {\r\n  margin: 0;\r\n}\r\n\r\n.search-results p {\r\n  margin: 5px 0 0;\r\n}\r\n</style>\r\n"],"mappings":"AAeA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;MACAC,WAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,CAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA;QACA,MAAAE,QAAA,SAAAX,KAAA,CAAAY,GAAA;QACA,KAAAT,WAAA,GAAAQ,QAAA,CAAAT,IAAA;MACA,SAAAW,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;EACA;EACAE,QAAA;IACAC,oBAAA;MACA,YAAAb,WAAA,CAAAc,MAAA,CAAAC,UAAA,IACAA,UAAA,CAAAjB,IAAA,CAAAkB,QAAA,MAAAf,WAAA,CACA;IACA;EACA;EACAgB,KAAA;IACA,2BAAAC,CAAAC,QAAA;MACA,KAAAlB,WAAA,GAAAkB,QAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}