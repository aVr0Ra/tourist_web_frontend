{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      searchQuery: ''\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    }\n  },\n  methods: {\n    logout() {\n      localStorage.removeItem('token');\n      this.$router.push('/');\n    },\n    searchAttractions() {\n      this.$router.push({\n        name: 'SearchResults',\n        query: {\n          q: this.searchQuery\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","searchQuery","computed","isLoggedIn","localStorage","getItem","methods","logout","removeItem","$router","push","searchAttractions","name","query","q"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <nav>\n      <div class=\"logo\">\n        <router-link to=\"/\">旅游网站</router-link>\n      </div>\n      <div class=\"auth\">\n        <div v-if=\"!isLoggedIn\">\n          <router-link to=\"/login\">登录</router-link>\n          <router-link to=\"/register\">注册</router-link>\n        </div>\n        <div v-else>\n          <button @click=\"logout\">注销</button>\n        </div>\n      </div>\n    </nav>\n    <div class=\"search-bar\">\n      <input type=\"text\" v-model=\"searchQuery\" placeholder=\"搜索景点...\" @keyup.enter=\"searchAttractions\">\n    </div>\n    <router-view/>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    }\n  },\n  methods: {\n    logout() {\n      localStorage.removeItem('token');\n      this.$router.push('/');\n    },\n    searchAttractions() {\n      this.$router.push({ name: 'SearchResults', query: { q: this.searchQuery } });\n    }\n  }\n}\n</script>\n\n<style>\n#app nav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px;\n  background-color: #42b983;\n  color: white;\n}