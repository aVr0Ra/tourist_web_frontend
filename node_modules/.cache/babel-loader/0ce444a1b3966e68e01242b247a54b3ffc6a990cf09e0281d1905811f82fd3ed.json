{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'SearchResults',\n  data() {\n    return {\n      attractions: [],\n      searchQuery: this.$route.query.q || '',\n      currentPage: 1,\n      itemsPerPage: 5\n    };\n  },\n  created() {\n    this.fetchAttractions();\n  },\n  methods: {\n    async fetchAttractions() {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/attractions');\n        this.attractions = response.data;\n      } catch (error) {\n        console.error('获取景点失败:', error);\n      }\n    },\n    truncateDescription(description) {\n      return description.length > 100 ? description.substring(0, 100) + '...' : description;\n    },\n    prevPage() {\n      if (this.currentPage > 1) {\n        this.currentPage--;\n      }\n    },\n    nextPage() {\n      if (this.currentPage < this.totalPages) {\n        this.currentPage++;\n      }\n    }\n  },\n  computed: {\n    filteredAttractions() {\n      return this.attractions.filter(attraction => attraction.name.includes(this.searchQuery) || attraction.address.includes(this.searchQuery));\n    },\n    paginatedAttractions() {\n      const start = (this.currentPage - 1) * this.itemsPerPage;\n      const end = start + this.itemsPerPage;\n      return this.filteredAttractions.slice(start, end);\n    },\n    totalPages() {\n      return Math.ceil(this.filteredAttractions.length / this.itemsPerPage);\n    }\n  },\n  watch: {\n    '$route.query.q': function (newQuery) {\n      this.searchQuery = newQuery;\n      this.currentPage = 1; // Reset to the first page for new search\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","attractions","searchQuery","$route","query","q","currentPage","itemsPerPage","created","fetchAttractions","methods","response","get","error","console","truncateDescription","description","length","substring","prevPage","nextPage","totalPages","computed","filteredAttractions","filter","attraction","includes","address","paginatedAttractions","start","end","slice","Math","ceil","watch","$route.query.q","newQuery"],"sources":["src/components/SearchResults.vue"],"sourcesContent":["<template>\r\n  <div class=\"search-results\">\r\n    <h1>搜索结果</h1>\r\n    <ul>\r\n      <li v-for=\"attraction in paginatedAttractions\" :key=\"attraction.id\" class=\"attraction-card\">\r\n        <router-link :to=\"`/attractions/${attraction.id}`\" class=\"attraction-link\">\r\n          <div class=\"attraction-info\">\r\n            <h3>{{ attraction.name }}</h3>\r\n            <p>{{ truncateDescription(attraction.description) }}</p>\r\n            <p><strong>地址:</strong> {{ attraction.address }}</p>\r\n          </div>\r\n          <div class=\"attraction-thumbnail\">\r\n            <img :src=\"attraction.images.length ? attraction.images[0].image : ''\" :alt=\"attraction.name\" />\r\n          </div>\r\n        </router-link>\r\n      </li>\r\n    </ul>\r\n    <div class=\"pagination\">\r\n      <button @click=\"prevPage\" :disabled=\"currentPage === 1\">上一页</button>\r\n      <span>第 {{ currentPage }} 页，共 {{ totalPages }} 页</span>\r\n      <button @click=\"nextPage\" :disabled=\"currentPage === totalPages\">下一页</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'SearchResults',\r\n  data() {\r\n    return {\r\n      attractions: [],\r\n      searchQuery: this.$route.query.q || '',\r\n      currentPage: 1,\r\n      itemsPerPage: 5\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAttractions();\r\n  },\r\n  methods: {\r\n    async fetchAttractions() {\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/attractions');\r\n        this.attractions = response.data;\r\n      } catch (error) {\r\n        console.error('获取景点失败:', error);\r\n      }\r\n    },\r\n    truncateDescription(description) {\r\n      return description.length > 100 ? description.substring(0, 100) + '...' : description;\r\n    },\r\n    prevPage() {\r\n      if (this.currentPage > 1) {\r\n        this.currentPage--;\r\n      }\r\n    },\r\n    nextPage() {\r\n      if (this.currentPage < this.totalPages) {\r\n        this.currentPage++;\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    filteredAttractions() {\r\n      return this.attractions.filter(attraction =>\r\n        attraction.name.includes(this.searchQuery) || attraction.address.includes(this.searchQuery)\r\n      );\r\n    },\r\n    paginatedAttractions() {\r\n      const start = (this.currentPage - 1) * this.itemsPerPage;\r\n      const end = start + this.itemsPerPage;\r\n      return this.filteredAttractions.slice(start, end);\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.filteredAttractions.length / this.itemsPerPage);\r\n    }\r\n  },\r\n  watch: {\r\n    '$route.query.q': function(newQuery) {\r\n      this.searchQuery = newQuery;\r\n      this.currentPage = 1; // Reset to the first page for new search\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.search-results {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.search-results ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.search-results li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n  display: flex;\r\n  align-items: center;\r\n  height: 150px; /* Ensure equal height for all cards */\r\n}\r\n\r\n.attraction-link {\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n  text-decoration: none;\r\n  color: inherit;\r\n}\r\n\r\n.attraction-info {\r\n  flex: 1;\r\n}\r\n\r\n.attraction-thumbnail {\r\n  width: 150px;\r\n  height: 150px;\r\n  margin-left: 10px;\r\n  overflow: hidden;\r\n}\r\n\r\n.attraction-thumbnail img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 20px;\r\n}\r\n\r\n.pagination button {\r\n  padding: 5px 10px;\r\n  font-size: 1em;\r\n}\r\n</style>\r\n"],"mappings":"AA0BA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;MACAC,WAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,CAAA;MACAC,WAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA;QACA,MAAAE,QAAA,SAAAb,KAAA,CAAAc,GAAA;QACA,KAAAX,WAAA,GAAAU,QAAA,CAAAX,IAAA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,oBAAAC,WAAA;MACA,OAAAA,WAAA,CAAAC,MAAA,SAAAD,WAAA,CAAAE,SAAA,mBAAAF,WAAA;IACA;IACAG,SAAA;MACA,SAAAb,WAAA;QACA,KAAAA,WAAA;MACA;IACA;IACAc,SAAA;MACA,SAAAd,WAAA,QAAAe,UAAA;QACA,KAAAf,WAAA;MACA;IACA;EACA;EACAgB,QAAA;IACAC,oBAAA;MACA,YAAAtB,WAAA,CAAAuB,MAAA,CAAAC,UAAA,IACAA,UAAA,CAAA1B,IAAA,CAAA2B,QAAA,MAAAxB,WAAA,KAAAuB,UAAA,CAAAE,OAAA,CAAAD,QAAA,MAAAxB,WAAA,CACA;IACA;IACA0B,qBAAA;MACA,MAAAC,KAAA,SAAAvB,WAAA,aAAAC,YAAA;MACA,MAAAuB,GAAA,GAAAD,KAAA,QAAAtB,YAAA;MACA,YAAAgB,mBAAA,CAAAQ,KAAA,CAAAF,KAAA,EAAAC,GAAA;IACA;IACAT,WAAA;MACA,OAAAW,IAAA,CAAAC,IAAA,MAAAV,mBAAA,CAAAN,MAAA,QAAAV,YAAA;IACA;EACA;EACA2B,KAAA;IACA,2BAAAC,CAAAC,QAAA;MACA,KAAAlC,WAAA,GAAAkC,QAAA;MACA,KAAA9B,WAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}