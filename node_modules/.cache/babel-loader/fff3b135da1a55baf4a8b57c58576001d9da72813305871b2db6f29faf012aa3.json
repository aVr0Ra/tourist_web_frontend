{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport SearchBar from './components/SearchBar.vue';\nexport default {\n  components: {\n    SearchBar\n  },\n  data() {\n    return {\n      showDropdown: false,\n      userAvatar: '',\n      userType: ''\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    showSearchBar() {\n      const noSearchRoutes = ['/login', '/register', '/profile', '/frequent-travelers'];\n      return !noSearchRoutes.includes(this.$route.path);\n    }\n  },\n  created() {\n    this.fetchUserProfile();\n  },\n  methods: {\n    toggleDropdown() {\n      this.showDropdown = !this.showDropdown;\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.$router.push('/');\n      location.reload();\n    },\n    async fetchUserProfile() {\n      const token = localStorage.getItem('token');\n      if (!token) return;\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.userAvatar = `http://127.0.0.1:8000${response.data.avatar}`;\n        this.userType = response.data.user_type;\n      } catch (error) {\n        console.error('获取用户资料失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["SearchBar","components","data","showDropdown","userAvatar","userType","computed","isLoggedIn","localStorage","getItem","showSearchBar","noSearchRoutes","includes","$route","path","created","fetchUserProfile","methods","toggleDropdown","logout","removeItem","$router","push","location","reload","token","response","axios","get","headers","avatar","user_type","error","console"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <header>\n      <router-link to=\"/\">旅游网站</router-link>\n      <div v-if=\"isLoggedIn\" class=\"dropdown\">\n        <img :src=\"userAvatar\" @click=\"toggleDropdown\" class=\"avatar\">\n        <div v-if=\"showDropdown\" class=\"dropdown-content\">\n          <router-link to=\"/profile\">编辑个人资料</router-link>\n          <router-link v-if=\"userType !== 'agent'\" to=\"/frequent-travelers\">添加/修改常用联系人</router-link>\n          <router-link to=\"/favorites\">收藏夹</router-link>\n          <button @click=\"logout\">注销</button>\n        </div>\n      </div>\n      <div v-else>\n        <router-link to=\"/login\">登录</router-link>\n        <router-link to=\"/register\">注册</router-link>\n      </div>\n    </header>\n    <search-bar v-if=\"showSearchBar\"></search-bar>\n    <router-view />\n  </div>\n</template>\n\n<script>\nimport SearchBar from './components/SearchBar.vue';\n\nexport default {\n  components: {\n    SearchBar\n  },\n  data() {\n    return {\n      showDropdown: false,\n      userAvatar: '',\n      userType: ''\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    showSearchBar() {\n      const noSearchRoutes = ['/login', '/register', '/profile', '/frequent-travelers'];\n      return !noSearchRoutes.includes(this.$route.path);\n    }\n  },\n  created() {\n    this.fetchUserProfile();\n  },\n  methods: {\n    toggleDropdown() {\n      this.showDropdown = !this.showDropdown;\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.$router.push('/');\n      location.reload();\n    },\n    async fetchUserProfile() {\n      const token = localStorage.getItem('token');\n      if (!token) return;\n      \n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.userAvatar = `http://127.0.0.1:8000${response.data.avatar}`;\n        this.userType = response.data.user_type;\n      } catch (error) {\n        console.error('获取用户资料失败:', error);\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.navbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px;\n  background-color: #42b983; /* 绿色背景 */\n}\n\n.site-title {\n  font-size: 2em;\n  color: white; /* 白色字体 */\n  text-decoration: none;\n}\n\n.user-menu {\n  position: relative;\n}\n\n.avatar {\n  width: 50px;\n  height: 50px;\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n.dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  background-color: white;\n  border: 1px solid #ccc;\n  border-radius: 5px;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);\n  padding: 10px;\n  white-space: nowrap; /* 保持选项在一行 */\n}\n\n.dropdown a,\n.dropdown button {\n  display: block;\n  padding: 10px;\n  text-decoration: none;\n  color: black;\n}\n\n.dropdown button {\n  border: none;\n  background: none;\n  cursor: pointer;\n  width: 100%;\n  text-align: left;\n}\n\n.dropdown a:hover,\n.dropdown button:hover {\n  background-color: #f0f0f0;\n}\n\n.auth-buttons {\n  display: flex;\n  gap: 10px;\n}\n\n.auth-buttons .btn {\n  padding: 10px 20px;\n  background-color: white;\n  color: #42b983;\n  border: 1px solid #42b983;\n  border-radius: 5px;\n  text-decoration: none;\n  cursor: pointer;\n}\n\n.auth-buttons .btn:hover {\n  background-color: #42b983;\n  color: white;\n}\n\n.search-bar {\n  display: flex;\n  justify-content: center;\n  margin-top: 10px;\n}\n\n.search-bar input {\n  width: 300px;\n  padding: 10px;\n  border: 1px solid #ccc;\n  border-radius: 5px 0 0 5px;\n}\n\n.search-bar button {\n  padding: 10px;\n  border: none;\n  background-color: #42b983;\n  color: white;\n  border-radius: 0 5px 5px 0;\n  cursor: pointer;\n}\n\n.search-bar button:hover {\n  background-color: #359a6d;\n}\n</style>\n"],"mappings":";AAwBA,OAAAA,SAAA;AAEA;EACAC,UAAA;IACAD;EACA;EACAE,KAAA;IACA;MACAC,YAAA;MACAC,UAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAC,YAAA,CAAAC,OAAA;IACA;IACAC,cAAA;MACA,MAAAC,cAAA;MACA,QAAAA,cAAA,CAAAC,QAAA,MAAAC,MAAA,CAAAC,IAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACAC