{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'AttractionDetail',\n  data() {\n    return {\n      attraction: null,\n      comments: [],\n      newCommentText: '',\n      newRating: '',\n      newImages: [],\n      currentPage: 1,\n      commentsPerPage: 5,\n      isFavorite: false\n    };\n  },\n  created() {\n    this.fetchAttractionDetails();\n    this.fetchComments();\n    this.checkIfFavorite();\n  },\n  methods: {\n    async fetchAttractionDetails() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/`);\n        this.attraction = response.data;\n      } catch (error) {\n        console.error('获取景点详情失败:', error);\n      }\n    },\n    async fetchComments() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/comments/`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败:', error);\n      }\n    },\n    handleImageUpload(event) {\n      const files = event.target.files;\n      for (let i = 0; i < files.length; i++) {\n        const reader = new FileReader();\n        reader.readAsDataURL(files[i]);\n        reader.onload = () => {\n          this.newImages.push({\n            image: reader.result.split(',')[1]\n          });\n        };\n      }\n    },\n    async postComment() {\n      const token = localStorage.getItem('token');\n      if (!this.newCommentText || !this.newRating || !token) {\n        alert('请填写所有字段并确保已登录');\n        return;\n      }\n      const payload = {\n        attraction: this.$route.params.id,\n        comment_text: this.newCommentText,\n        rating: this.newRating,\n        is_featured: false,\n        images: this.newImages\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/comments/', payload, {\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.newCommentText = '';\n        this.newRating = '';\n        this.newImages = [];\n        this.fetchComments();\n      } catch (error) {\n        console.error('发表评论失败:', error);\n      }\n    },\n    async checkIfFavorite() {\n      const token = localStorage.getItem('token');\n      if (!token) return;\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.isFavorite = response.data.some(favorite => favorite.attraction === this.$route.params.id);\n      } catch (error) {\n        console.error('检查收藏状态失败:', error);\n      }\n    },\n    async toggleFavorite() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      if (this.isFavorite) {\n        try {\n          const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          const favorite = response.data.find(fav => fav.attraction === this.$route.params.id);\n          if (favorite) {\n            await axios.delete(`http://127.0.0.1:8000/api/favorites/${favorite.id}/`, {\n              headers: {\n                'Authorization': `Token ${token}`\n              }\n            });\n            this.isFavorite = false;\n          }\n        } catch (error) {\n          console.error('取消收藏失败:', error);\n        }\n      } else {\n        try {\n          await axios.post('http://127.0.0.1:8000/api/favorites/', {\n            attraction: this.$route.params.id\n          }, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          this.isFavorite = true;\n        } catch (error) {\n          console.error('收藏失败:', error);\n        }\n      }\n    },\n    prevPage() {\n      if (this.currentPage > 1) {\n        this.currentPage--;\n      }\n    },\n    nextPage() {\n      if (this.currentPage < this.totalPages) {\n        this.currentPage++;\n      }\n    }\n  },\n  computed: {\n    paginatedComments() {\n      const start = (this.currentPage - 1) * this.commentsPerPage;\n      const end = start + this.commentsPerPage;\n      return this.comments.slice(start, end);\n    },\n    totalPages() {\n      return Math.ceil(this.comments.length / this.commentsPerPage);\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","attraction","comments","newCommentText","newRating","newImages","currentPage","commentsPerPage","isFavorite","created","fetchAttractionDetails","fetchComments","checkIfFavorite","methods","attractionId","$route","params","id","response","get","error","console","handleImageUpload","event","files","target","i","length","reader","FileReader","readAsDataURL","onload","push","image","result","split","postComment","token","localStorage","getItem","alert","payload","comment_text","rating","is_featured","images","post","headers","some","favorite","toggleFavorite","find","fav","delete","prevPage","nextPage","totalPages","computed","paginatedComments","start","end","slice","Math","ceil"],"sources":["src/components/AttractionDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"attraction-detail\">\r\n    <h1>{{ attraction.name }}</h1>\r\n    <img :src=\"attraction.images[0].image\" :alt=\"attraction.name\" class=\"attraction-image\">\r\n    <p><strong>星级:</strong> {{ attraction.star_level }}</p>\r\n    <p><strong>评分:</strong> {{ attraction.rating }}</p>\r\n    <p><strong>描述:</strong> {{ attraction.description }}</p>\r\n    <p><strong>开放时间:</strong> {{ attraction.opening_hours }}</p>\r\n    <p><strong>地址:</strong> {{ attraction.address }}</p>\r\n    <p><strong>联系电话:</strong> {{ attraction.official_phone }}</p>\r\n    <p><strong>人气:</strong> {{ attraction.popularity }}</p>\r\n    <p><strong>评论数:</strong> {{ attraction.comment_count }}</p>\r\n    <button @click=\"toggleFavorite\">{{ isFavorite ? '取消收藏' : '收藏' }}</button>\r\n\r\n    <div class=\"comments\">\r\n      <h2>评论区</h2>\r\n      <div class=\"new-comment\">\r\n        <textarea v-model=\"newCommentText\" placeholder=\"发表评论\"></textarea>\r\n        <input type=\"range\" v-model=\"newRating\" min=\"0\" max=\"9.9\" step=\"0.1\">\r\n        <input type=\"file\" @change=\"handleImageUpload\" multiple>\r\n        <button @click=\"postComment\">提交评论</button>\r\n      </div>\r\n      <ul>\r\n        <li v-for=\"comment in paginatedComments\" :key=\"comment.id\">\r\n          <p class=\"comment-rating\">{{ comment.rating }}/10分</p>\r\n          <p class=\"comment-text\">{{ comment.comment_text }}</p>\r\n          <img v-if=\"comment.images.length\" :src=\"comment.images[0].image\" :alt=\"comment.comment_text\" class=\"comment-image\">\r\n          <p class=\"comment-date\">发表于: {{ new Date(comment.created_at).toLocaleString() }}</p>\r\n        </li>\r\n      </ul>\r\n      <div class=\"pagination\">\r\n        <button @click=\"prevPage\" :disabled=\"currentPage === 1\">上一页</button>\r\n        <span>第 {{ currentPage }} 页，共 {{ totalPages }} 页</span>\r\n        <button @click=\"nextPage\" :disabled=\"currentPage === totalPages\">下一页</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'AttractionDetail',\r\n  data() {\r\n    return {\r\n      attraction: null,\r\n      comments: [],\r\n      newCommentText: '',\r\n      newRating: '',\r\n      newImages: [],\r\n      currentPage: 1,\r\n      commentsPerPage: 5,\r\n      isFavorite: false\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAttractionDetails();\r\n    this.fetchComments();\r\n    this.checkIfFavorite();\r\n  },\r\n  methods: {\r\n    async fetchAttractionDetails() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/`);\r\n        this.attraction = response.data;\r\n      } catch (error) {\r\n        console.error('获取景点详情失败:', error);\r\n      }\r\n    },\r\n    async fetchComments() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/comments/`);\r\n        this.comments = response.data;\r\n      } catch (error) {\r\n        console.error('获取评论失败:', error);\r\n      }\r\n    },\r\n    handleImageUpload(event) {\r\n      const files = event.target.files;\r\n      for (let i = 0; i < files.length; i++) {\r\n        const reader = new FileReader();\r\n        reader.readAsDataURL(files[i]);\r\n        reader.onload = () => {\r\n          this.newImages.push({ image: reader.result.split(',')[1] });\r\n        };\r\n      }\r\n    },\r\n    async postComment() {\r\n      const token = localStorage.getItem('token');\r\n      if (!this.newCommentText || !this.newRating || !token) {\r\n        alert('请填写所有字段并确保已登录');\r\n        return;\r\n      }\r\n\r\n      const payload = {\r\n        attraction: this.$route.params.id,\r\n        comment_text: this.newCommentText,\r\n        rating: this.newRating,\r\n        is_featured: false,\r\n        images: this.newImages\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/comments/', payload, {\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.newCommentText = '';\r\n        this.newRating = '';\r\n        this.newImages = [];\r\n        this.fetchComments();\r\n      } catch (error) {\r\n        console.error('发表评论失败:', error);\r\n      }\r\n    },\r\n    async checkIfFavorite() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) return;\r\n\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.isFavorite = response.data.some(favorite => favorite.attraction === this.$route.params.id);\r\n      } catch (error) {\r\n        console.error('检查收藏状态失败:', error);\r\n      }\r\n    },\r\n    async toggleFavorite() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      if (this.isFavorite) {\r\n        try {\r\n          const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n          const favorite = response.data.find(fav => fav.attraction === this.$route.params.id);\r\n          if (favorite) {\r\n            await axios.delete(`http://127.0.0.1:8000/api/favorites/${favorite.id}/`, {\r\n              headers: {\r\n                'Authorization': `Token ${token}`\r\n              }\r\n            });\r\n            this.isFavorite = false;\r\n          }\r\n        } catch (error) {\r\n          console.error('取消收藏失败:', error);\r\n        }\r\n      } else {\r\n        try {\r\n          await axios.post('http://127.0.0.1:8000/api/favorites/', { attraction: this.$route.params.id }, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n          this.isFavorite = true;\r\n        } catch (error) {\r\n          console.error('收藏失败:', error);\r\n        }\r\n      }\r\n    },\r\n    prevPage() {\r\n      if (this.currentPage > 1) {\r\n        this.currentPage--;\r\n      }\r\n    },\r\n    nextPage() {\r\n      if (this.currentPage < this.totalPages) {\r\n        this.currentPage++;\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    paginatedComments() {\r\n      const start = (this.currentPage - 1) * this.commentsPerPage;\r\n      const end = start + this.commentsPerPage;\r\n      return this.comments.slice(start, end);\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.comments.length / this.commentsPerPage);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.attraction-detail {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  text-align: left;\r\n}\r\n.attraction-image {\r\n  width: 100%;\r\n  height: auto;\r\n}\r\n.comments {\r\n  margin-top: 20px;\r\n}\r\n.new-comment {\r\n  margin-bottom: 20px;\r\n}\r\n.new-comment textarea {\r\n  width: 100%;\r\n  height: 100px;\r\n}\r\n.new-comment input[type=\"range\"] {\r\n  width: 100%;\r\n  margin-top: 10px;\r\n}\r\n.new-comment input[type=\"file\"] {\r\n  margin-top: 10px;\r\n}\r\n.new-comment button {\r\n  margin-top: 10px;\r\n}\r\n.comments ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n.comments li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n.comment-rating {\r\n  font-size: 1.2em;\r\n  font-weight: bold;\r\n}\r\n.comment-text {\r\n  font-size: 1em;\r\n}\r\n.comment-image {\r\n  width: 500px;\r\n  height: auto;\r\n  margin-top: 10px;\r\n}\r\n.comment-date {\r\n  font-size: 0.8em;\r\n  color: #777;\r\n}\r\n.pagination {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 20px;\r\n}\r\n.pagination button {\r\n  padding: 5px 10px;\r\n  font-size: 1em;\r\n}\r\n</style>\r\n"],"mappings":";AAwCA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,QAAA;MACAC,cAAA;MACAC,SAAA;MACAC,SAAA;MACAC,WAAA;MACAC,eAAA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,sBAAA;IACA,KAAAC,aAAA;IACA,KAAAC,eAAA;EACA;EACAC,OAAA;IACA,MAAAH,uBAAA;MACA,MAAAI,YAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA;QACA,MAAAC,QAAA,SAAApB,KAAA,CAAAqB,GAAA,0CAAAL,YAAA;QACA,KAAAb,UAAA,G