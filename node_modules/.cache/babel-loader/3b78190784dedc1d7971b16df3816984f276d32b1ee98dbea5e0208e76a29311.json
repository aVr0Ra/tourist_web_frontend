{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'LoginPage',\n  data() {\n    return {\n      username: '',\n      password: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/login/', {\n          username: this.username,\n          password: this.password\n        });\n        localStorage.setItem('token', response.data.token);\n        this.$emit('login');\n        this.$router.push('/');\n      } catch (error) {\n        alert('登录失败，请检查您的用户名和密码');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","username","password","methods","login","response","post","localStorage","setItem","token","$emit","$router","push","error","alert"],"sources":["src/components/LoginPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"auth-page\">\r\n    <h2>登录</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"username\">用户名:</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">密码:</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required>\r\n      </div>\r\n      <button type=\"submit\">登录</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: ''\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/login/', {\r\n          username: this.username,\r\n          password: this.password\r\n        });\r\n        localStorage.setItem('token', response.data.token);\r\n        this.$emit('login');\r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        alert('登录失败，请检查您的用户名和密码');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.auth-page {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\nform div {\r\n  margin-bottom: 15px;\r\n}\r\nform label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\nform input {\r\n  width: 100%;\r\n  padding: 8px;\r\n  box-sizing: border-box;\r\n}\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\nbutton:hover {\r\n  background-color: #42b983;\r\n  color: white;\r\n}\r\n</style>\r\n"],"mappings":";AAkBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,MAAA;MACA;QACA,MAAAC,QAAA,SAAAP,KAAA,CAAAQ,IAAA;UACAL,QAAA,OAAAA,QAAA;UACAC,QAAA,OAAAA;QACA;QACAK,YAAA,CAAAC,OAAA,UAAAH,QAAA,CAAAL,IAAA,CAAAS,KAAA;QACA,KAAAC,KAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,SAAAC,KAAA;QACAC,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}