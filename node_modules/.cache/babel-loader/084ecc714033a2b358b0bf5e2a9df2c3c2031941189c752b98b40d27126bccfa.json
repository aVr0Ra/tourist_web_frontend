{"ast":null,"code":"import axios from 'axios';\nimport DestinationCard from './DestinationCard.vue';\nexport default {\n  name: 'FavoritesPage',\n  components: {\n    DestinationCard\n  },\n  data() {\n    return {\n      favorites: []\n    };\n  },\n  created() {\n    this.fetchFavorites();\n  },\n  methods: {\n    async fetchFavorites() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        const favoriteIds = response.data.map(favorite => favorite.attraction);\n        const attractionsResponse = await axios.get('http://127.0.0.1:8000/api/attractions/');\n        const attractions = attractionsResponse.data.filter(attraction => favoriteIds.includes(attraction.id));\n        this.favorites = attractions.map(attraction => ({\n          attraction\n        }));\n      } catch (error) {\n        console.error('获取收藏夹失败:', error);\n      }\n    },\n    async removeFavorite(attractionId) {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        const favorite = response.data.find(fav => fav.attraction === attractionId);\n        if (favorite) {\n          await axios.delete(`http://127.0.0.1:8000/api/favorites/${favorite.id}/`, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          this.favorites = this.favorites.filter(favorite => favorite.attraction.id !== attractionId);\n        }\n      } catch (error) {\n        console.error('删除收藏失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","DestinationCard","name","components","data","favorites","created","fetchFavorites","methods","token","localStorage","getItem","alert","response","get","headers","favoriteIds","map","favorite","attraction","attractionsResponse","attractions","filter","includes","id","error","console","removeFavorite","attractionId","find","fav","delete"],"sources":["src/components/FavoritesPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"favorites-page\">\r\n    <h1>收藏夹</h1>\r\n    <div class=\"favorites-grid\">\r\n      <div v-for=\"favorite in favorites\" :key=\"favorite.attraction.id\" class=\"favorite-item\">\r\n        <router-link :to=\"{ name: 'AttractionDetail', params: { id: favorite.attraction.id } }\">\r\n          <DestinationCard\r\n            :image=\"favorite.attraction.images.length > 0 ? favorite.attraction.images[0].image : ''\"\r\n            :title=\"favorite.attraction.name\"\r\n            :description=\"favorite.attraction.description\"\r\n          />\r\n        </router-link>\r\n        <button @click=\"removeFavorite(favorite.attraction.id)\">取消收藏</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport DestinationCard from './DestinationCard.vue';\r\n\r\nexport default {\r\n  name: 'FavoritesPage',\r\n  components: {\r\n    DestinationCard\r\n  },\r\n  data() {\r\n    return {\r\n      favorites: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFavorites();\r\n  },\r\n  methods: {\r\n    async fetchFavorites() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n\r\n        const favoriteIds = response.data.map(favorite => favorite.attraction);\r\n\r\n        const attractionsResponse = await axios.get('http://127.0.0.1:8000/api/attractions/');\r\n        const attractions = attractionsResponse.data.filter(attraction => favoriteIds.includes(attraction.id));\r\n\r\n        this.favorites = attractions.map(attraction => ({ attraction }));\r\n      } catch (error) {\r\n        console.error('获取收藏夹失败:', error);\r\n      }\r\n    },\r\n    async removeFavorite(attractionId) {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n\r\n        const favorite = response.data.find(fav => fav.attraction === attractionId);\r\n\r\n        if (favorite) {\r\n          await axios.delete(`http://127.0.0.1:8000/api/favorites/${favorite.id}/`, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n          this.favorites = this.favorites.filter(favorite => favorite.attraction.id !== attractionId);\r\n        }\r\n      } catch (error) {\r\n        console.error('删除收藏失败:', error);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.favorites-page {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n.favorites-grid {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n.favorite-item {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  background-color: #d9534f;\r\n  color: white;\r\n  cursor: pointer;\r\n  display: block;\r\n  margin-top: 10px;\r\n  width: 100%;\r\n}\r\nbutton:hover {\r\n  background-color: #c9302c;\r\n}\r\n</style>\r\n"],"mappings":"AAmBA,OAAAA,KAAA;AACA,OAAAC,eAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;