dule.id,\n        status: true\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/reservations/', reservationData, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        alert('预约成功');\n        this.$router.push('/');\n      } catch (error) {\n        console.error('预约失败:', error);\n        alert('预约失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","user","route","schedule","created","fetchProfile","fetchRouteDetails","fetchScheduleDetails","methods","token","localStorage","getItem","response","get","headers","error","console","routeId","$route","params","scheduleId","confirmReservation","alert","reservationData","rv_date","Date","toISOString","split","tr_id","id","rt_rq_id","status","post","$router","push"],"sources":["src/components/ReserveRoute.vue"],"sourcesContent":["<template>\r\n  <div class=\"reserve-route\">\r\n    <h1>确认预约</h1>\r\n    <div v-if=\"user\">\r\n      <p><strong>用户名:</strong> {{ user.username }}</p>\r\n      <p><strong>线路名称:</strong> {{ route.rt_name }}</p>\r\n      <p><strong>线路简介:</strong> {{ route.rt_brief }}</p>\r\n      <p><strong>价格:</strong> {{ route.price }}</p>\r\n      <p><strong>开始日期:</strong> {{ schedule.rq }}</p>\r\n      <button @click=\"confirmReservation\">确认预约</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'ReserveRoute',\r\n  data() {\r\n    return {\r\n      user: null,\r\n      route: null,\r\n      schedule: null\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchProfile();\r\n    this.fetchRouteDetails();\r\n    this.fetchScheduleDetails();\r\n  },\r\n  methods: {\r\n    async fetchProfile() {\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.user = response.data.user;\r\n      } catch (error) {\r\n        console.error('获取用户信息失败:', error);\r\n      }\r\n    },\r\n    async fetchRouteDetails() {\r\n      const routeId = this.$route.params.routeId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${routeId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.route = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路详情失败:', error);\r\n      }\r\n    },\r\n    async fetchScheduleDetails() {\r\n      const scheduleId = this.$route.params.scheduleId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_rq/${scheduleId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.schedule = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路时间详情失败:', error);\r\n      }\r\n    },\r\n    async confirmReservation() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      const reservationData = {\r\n        rv_date: new Date().toISOString().split('T')[0],\r\n        tr_id: this.user.id,\r\n        rt_rq_id: this.schedule.id,\r\n        status: true\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/reservations/', reservationData, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        alert('预约成功');\r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        console.error('预约失败:', error);\r\n        alert('预约失败');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.reserve-route {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.reserve-route p {\r\n  text-align: left;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n</style>\r\n"],"mappings":";AAeA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,KAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,YAAA;IACA,KAAAC,iBAAA;IACA,KAAAC,oBAAA;EACA;EACAC,OAAA;IACA,MAAAH,aAAA;MACA,MAAAI,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAAd,KAAA,CAAAe,GAAA;UACAC,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAR,IAAA,GAAAW,QAAA,CAAAZ,IAAA,CAAAC,IAAA;MACA,SAAAc,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAT,kBAAA;MACA,MAAAW,OAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,OAAA;MACA,MAAAR,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAAd,KAAA,CAAAe,GAAA,qCAAAI,OAAA;UACAH,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAP,KAAA,GAAAU,QAAA,CAAAZ,IAAA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAR,qBAAA;MACA,MAAAa,UAAA,QAAAF,MAAA,CAAAC,MAAA,CAAAC,UAAA;MACA,MAAAX,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAAd,KAAA,CAAAe,GAAA,oCAAAO,UAAA;UACAN,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAN,QAAA,GAAAS,QAAA,CAAAZ,IAAA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,gBAAAA,KAAA;MACA;IACA;IACA,MAAAM,mBAAA;MACA,MAAAZ,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAa,KAAA;QACA;MACA;MAEA,MAAAC,eAAA;QACAC,OAAA,MAAAC,IAAA,GAAAC,WAAA,GAAAC,KAAA;QACAC,KAAA,OAAA3B,IAAA,CAAA4B,EAAA;QACAC,QAAA,OAAA3B,QAAA,CAAA0B,EAAA;QACAE,MAAA;MACA;MAEA;QACA,MAAAjC,KAAA,CAAAkC,IAAA,4CAAAT,eAAA;UACAT,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACAa,KAAA;QACA,KAAAW,OAAA,CAAAC,IAAA;MACA,SAAAnB,KAAA;QACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;QACAO,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}