{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'SetRouteDates',\n  data() {\n    return {\n      routeId: null,\n      date: '',\n      days: 1,\n      limit: 1,\n      routeDates: [],\n      isEditing: false,\n      editingIndex: null\n    };\n  },\n  created() {\n    this.routeId = this.$route.params.routeId;\n  },\n  methods: {\n    addOrUpdateRouteDate() {\n      if (this.date && this.days > 0 && this.limit > 0) {\n        const routeDate = {\n          rq: this.date,\n          days: this.days,\n          limit: this.limit\n        };\n        if (this.isEditing) {\n          this.routeDates.splice(this.editingIndex, 1, routeDate);\n          this.isEditing = false;\n          this.editingIndex = null;\n        } else {\n          this.routeDates.push(routeDate);\n        }\n        this.date = '';\n        this.days = 1;\n        this.limit = 1;\n      } else {\n        alert('请填写有效的时间、天数和人数上限');\n      }\n    },\n    editRouteDate(index) {\n      const routeDate = this.routeDates[index];\n      this.date = routeDate.rq;\n      this.days = routeDate.days;\n      this.limit = routeDate.limit;\n      this.isEditing = true;\n      this.editingIndex = index;\n    },\n    cancelEdit() {\n      this.isEditing = false;\n      this.editingIndex = null;\n      this.date = '';\n      this.days = 1;\n      this.limit = 1;\n    },\n    deleteRouteDate(index) {\n      this.routeDates.splice(index, 1);\n    },\n    async submitRouteDates() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        for (const routeDate of this.routeDates) {\n          await axios.post('http://127.0.0.1:8000/api/rt_rq/', {\n            rt_id: this.routeId,\n            rq: routeDate.rq,\n            days: routeDate.days,\n            limit: routeDate.limit\n          }, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n        }\n        alert('线路时间提交成功');\n        this.$router.push('/');\n      } catch (error) {\n        console.error('提交线路时间失败:', error);\n        alert('提交线路时间失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","routeId","date","days","limit","routeDates","isEditing","editingIndex","created","$route","params","methods","addOrUpdateRouteDate","routeDate","rq","splice","push","alert","editRouteDate","index","cancelEdit","deleteRouteDate","submitRouteDates","token","localStorage","getItem","post","rt_id","headers","$router","error","console"],"sources":["src/components/SetRouteDates.vue"],"sourcesContent":["<template>\r\n  <div class=\"set-route-dates\">\r\n    <h1>设置线路时间</h1>\r\n    <form @submit.prevent=\"addOrUpdateRouteDate\">\r\n      <div class=\"form-group\">\r\n        <label for=\"date\">开始日期:</label>\r\n        <input type=\"date\" id=\"date\" v-model=\"date\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"days\">持续天数:</label>\r\n        <input type=\"number\" id=\"days\" v-model=\"days\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"limit\">人数上限:</label>\r\n        <input type=\"number\" id=\"limit\" v-model=\"limit\" required>\r\n      </div>\r\n      <button type=\"submit\" class=\"add-button\">{{ isEditing ? '修改时间' : '添加时间' }}</button>\r\n      <button v-if=\"isEditing\" @click=\"cancelEdit\" class=\"cancel-button\">取消修改</button>\r\n    </form>\r\n    <ul class=\"route-dates-list\">\r\n      <li v-for=\"(routeDate, index) in routeDates\" :key=\"index\">\r\n        {{ routeDate.rq }} - {{ routeDate.days }} 天 - 上限 {{ routeDate.limit }} 人\r\n        <button @click=\"editRouteDate(index)\">修改</button>\r\n        <button @click=\"deleteRouteDate(index)\">删除</button>\r\n      </li>\r\n    </ul>\r\n    <button @click=\"submitRouteDates\" class=\"submit-button\">提交线路时间</button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'SetRouteDates',\r\n  data() {\r\n    return {\r\n      routeId: null,\r\n      date: '',\r\n      days: 1,\r\n      limit: 1,\r\n      routeDates: [],\r\n      isEditing: false,\r\n      editingIndex: null\r\n    };\r\n  },\r\n  created() {\r\n    this.routeId = this.$route.params.routeId;\r\n  },\r\n  methods: {\r\n    addOrUpdateRouteDate() {\r\n      if (this.date && this.days > 0 && this.limit > 0) {\r\n        const routeDate = { rq: this.date, days: this.days, limit: this.limit };\r\n        if (this.isEditing) {\r\n          this.routeDates.splice(this.editingIndex, 1, routeDate);\r\n          this.isEditing = false;\r\n          this.editingIndex = null;\r\n        } else {\r\n          this.routeDates.push(routeDate);\r\n        }\r\n        this.date = '';\r\n        this.days = 1;\r\n        this.limit = 1;\r\n      } else {\r\n        alert('请填写有效的时间、天数和人数上限');\r\n      }\r\n    },\r\n    editRouteDate(index) {\r\n      const routeDate = this.routeDates[index];\r\n      this.date = routeDate.rq;\r\n      this.days = routeDate.days;\r\n      this.limit = routeDate.limit;\r\n      this.isEditing = true;\r\n      this.editingIndex = index;\r\n    },\r\n    cancelEdit() {\r\n      this.isEditing = false;\r\n      this.editingIndex = null;\r\n      this.date = '';\r\n      this.days = 1;\r\n      this.limit = 1;\r\n    },\r\n    deleteRouteDate(index) {\r\n      this.routeDates.splice(index, 1);\r\n    },\r\n    async submitRouteDates() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        for (const routeDate of this.routeDates) {\r\n          await axios.post('http://127.0.0.1:8000/api/rt_rq/', {\r\n            rt_id: this.routeId,\r\n            rq: routeDate.rq,\r\n            days: routeDate.days,\r\n            limit: routeDate.limit\r\n          }, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n        }\r\n        alert('线路时间提交成功');\r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        console.error('提交线路时间失败:', error);\r\n        alert('提交线路时间失败');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.set-route-dates {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n\r\n.add-button, .cancel-button {\r\n  margin-bottom: 20px;\r\n  margin-right: 10px;\r\n}\r\n\r\n.submit-button {\r\n  margin-top: 20px;\r\n  width: 100%;\r\n}\r\n\r\n.route-dates-list {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.route-dates-list li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.route-dates-list button {\r\n  margin-left: 10px;\r\n}\r\n</style>\r\n"],"mappings":";AA+BA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,IAAA;MACAC,IAAA;MACAC,KAAA;MACAC,UAAA;MACAC,SAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAP,OAAA,QAAAQ,MAAA,CAAAC,MAAA,CAAAT,OAAA;EACA;EACAU,OAAA;IACAC,qBAAA;MACA,SAAAV,IAAA,SAAAC,IAAA,aAAAC,KAAA;QACA,MAAAS,SAAA;UAAAC,EAAA,OAAAZ,IAAA;UAAAC,IAAA,OAAAA,IAAA;UAAAC,KAAA,OAAAA;QAAA;QACA,SAAAE,SAAA;UACA,KAAAD,UAAA,CAAAU,MAAA,MAAAR,YAAA,KAAAM,SAAA;UACA,KAAAP,SAAA;UACA,KAAAC,YAAA;QACA;UACA,KAAAF,UAAA,CAAAW,IAAA,CAAAH,SAAA;QACA;QACA,KAAAX,IAAA;QACA,KAAAC,IAAA;QACA,KAAAC,KAAA;MACA;QACAa,KAAA;MACA;IACA