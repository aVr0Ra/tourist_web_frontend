{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'RouteDetails',\n  data() {\n    return {\n      routeId: null,\n      routeDetails: {},\n      attractions: [],\n      routeDates: [],\n      showAddDateForm: false,\n      date: '',\n      days: 1,\n      limit: 1\n    };\n  },\n  created() {\n    this.routeId = this.$route.params.routeId;\n    this.fetchRouteDetails();\n    this.fetchRouteAttractions();\n    this.fetchRouteDates();\n  },\n  methods: {\n    async fetchRouteDetails() {\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${this.routeId}`);\n        this.routeDetails = response.data;\n      } catch (error) {\n        console.error('获取线路详情失败:', error);\n      }\n    },\n    async fetchRouteAttractions() {\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_at/route/${this.routeId}/`);\n        this.attractions = response.data;\n      } catch (error) {\n        console.error('获取线路景点失败:', error);\n      }\n    },\n    async fetchRouteDates() {\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_rq/route/${this.routeId}/`);\n        this.routeDates = response.data;\n      } catch (error) {\n        console.error('获取线路时间失败:', error);\n      }\n    },\n    toggleAddDateForm() {\n      this.showAddDateForm = !this.showAddDateForm;\n    },\n    async addRouteDate() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      const routeDateData = {\n        rt_id: this.routeId,\n        rq: this.date,\n        days: this.days,\n        limit: this.limit\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/rt_rq/', routeDateData, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        alert('线路时间添加成功');\n        this.fetchRouteDates();\n        this.toggleAddDateForm();\n        this.date = '';\n        this.days = 1;\n        this.limit = 1;\n      } catch (error) {\n        console.error('添加线路时间失败:', error);\n        alert('添加线路时间失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","routeId","routeDetails","attractions","routeDates","showAddDateForm","date","days","limit","created","$route","params","fetchRouteDetails","fetchRouteAttractions","fetchRouteDates","methods","response","get","error","console","toggleAddDateForm","addRouteDate","token","localStorage","getItem","alert","routeDateData","rt_id","rq","post","headers"],"sources":["src/components/RouteDetails.vue"],"sourcesContent":["<template>\r\n  <div class=\"route-details\">\r\n    <h1>{{ routeDetails.rt_name }}</h1>\r\n    <p><strong>简介:</strong> {{ routeDetails.rt_brief }}</p>\r\n    <p><strong>价格:</strong> {{ routeDetails.price }}</p>\r\n    <div class=\"attractions\">\r\n      <h2>经过景点:</h2>\r\n      <div class=\"attraction-list\">\r\n        <span v-for=\"(attraction, index) in attractions\" :key=\"index\">\r\n          {{ attraction.name }}<span v-if=\"index < attractions.length - 1\"> -> </span>\r\n        </span>\r\n      </div>\r\n    </div>\r\n    <div class=\"route-dates\">\r\n      <h2>已经安排的时间:</h2>\r\n      <ul>\r\n        <li v-for=\"(date, index) in routeDates\" :key=\"index\">\r\n          {{ date.rq }} - {{ date.days }} 天 - 上限 {{ date.limit }} 人\r\n        </li>\r\n      </ul>\r\n    </div>\r\n    <button @click=\"toggleAddDateForm\" v-if=\"!showAddDateForm\">添加新日期</button>\r\n    <form @submit.prevent=\"addRouteDate\" v-if=\"showAddDateForm\">\r\n      <div class=\"form-group\">\r\n        <label for=\"date\">开始日期:</label>\r\n        <input type=\"date\" id=\"date\" v-model=\"date\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"days\">持续天数:</label>\r\n        <input type=\"number\" id=\"days\" v-model=\"days\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"limit\">人数上限:</label>\r\n        <input type=\"number\" id=\"limit\" v-model=\"limit\" required>\r\n      </div>\r\n      <button type=\"submit\" class=\"add-button\">提交日期</button>\r\n      <button type=\"button\" @click=\"toggleAddDateForm\" class=\"cancel-button\">取消</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'RouteDetails',\r\n  data() {\r\n    return {\r\n      routeId: null,\r\n      routeDetails: {},\r\n      attractions: [],\r\n      routeDates: [],\r\n      showAddDateForm: false,\r\n      date: '',\r\n      days: 1,\r\n      limit: 1\r\n    };\r\n  },\r\n  created() {\r\n    this.routeId = this.$route.params.routeId;\r\n    this.fetchRouteDetails();\r\n    this.fetchRouteAttractions();\r\n    this.fetchRouteDates();\r\n  },\r\n  methods: {\r\n    async fetchRouteDetails() {\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${this.routeId}`);\r\n        this.routeDetails = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路详情失败:', error);\r\n      }\r\n    },\r\n    async fetchRouteAttractions() {\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_at/route/${this.routeId}/`);\r\n        this.attractions = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路景点失败:', error);\r\n      }\r\n    },\r\n    async fetchRouteDates() {\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_rq/route/${this.routeId}/`);\r\n        this.routeDates = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路时间失败:', error);\r\n      }\r\n    },\r\n    toggleAddDateForm() {\r\n      this.showAddDateForm = !this.showAddDateForm;\r\n    },\r\n    async addRouteDate() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      const routeDateData = {\r\n        rt_id: this.routeId,\r\n        rq: this.date,\r\n        days: this.days,\r\n        limit: this.limit\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/rt_rq/', routeDateData, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        alert('线路时间添加成功');\r\n        this.fetchRouteDates();\r\n        this.toggleAddDateForm();\r\n        this.date = '';\r\n        this.days = 1;\r\n        this.limit = 1;\r\n      } catch (error) {\r\n        console.error('添加线路时间失败:', error);\r\n        alert('添加线路时间失败');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.route-details {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  text-align: left;\r\n}\r\n\r\n.attractions, .route-dates {\r\n  margin-top: 20px;\r\n}\r\n\r\n.attraction-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.attraction-list span {\r\n  margin-right: 5px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  margin-right: 10px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n\r\n.add-button {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.cancel-button {\r\n  background-color: #d9534f;\r\n}\r\n\r\n.cancel-button:hover {\r\n  background-color: #c9302c;\r\n}\r\n\r\nul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\nul li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n</style>\r\n"],"mappings":"AA0CA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,YAAA;MACAC,WAAA;MACAC,UAAA;MACAC,eAAA;MACAC,IAAA;MACAC,IAAA;MACAC,KAAA;IACA;EACA;EACAC,QAAA;IAC