{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'FavoritesPage',\n  data() {\n    return {\n      favorites: []\n    };\n  },\n  created() {\n    this.fetchFavorites();\n  },\n  methods: {\n    async fetchFavorites() {\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.favorites = response.data;\n      } catch (error) {\n        console.error('获取收藏失败:', error);\n      }\n    },\n    async removeFavorite(attractionId) {\n      const token = localStorage.getItem('token');\n      try {\n        await axios.delete(`http://127.0.0.1:8000/api/favorites/${attractionId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.fetchFavorites();\n      } catch (error) {\n        console.error('取消收藏失败:', error);\n      }\n    },\n    goToAttractionDetail(attractionId) {\n      this.$router.push(`/attractions/${attractionId}`);\n    },\n    getImage(attractionId) {\n      const attraction = this.$store.state.attractions.find(a => a.id === attractionId);\n      return attraction ? attraction.images[0].image : '';\n    },\n    getAttractionName(attractionId) {\n      const attraction = this.$store.state.attractions.find(a => a.id === attractionId);\n      return attraction ? attraction.name : '';\n    },\n    getAttractionDescription(attractionId) {\n      const attraction = this.$store.state.attractions.find(a => a.id === attractionId);\n      return attraction ? attraction.description.length > 100 ? attraction.description.substring(0, 100) + '...' : attraction.description : '';\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","favorites","created","fetchFavorites","methods","token","localStorage","getItem","response","get","headers","error","console","removeFavorite","attractionId","delete","goToAttractionDetail","$router","push","getImage","attraction","$store","state","attractions","find","a","id","images","image","getAttractionName","getAttractionDescription","description","length","substring"],"sources":["src/components/FavoritesPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"favorites\">\r\n    <h1>收藏夹</h1>\r\n    <div class=\"favorites-list\">\r\n      <div v-for=\"favorite in favorites\" :key=\"favorite.id\" class=\"favorite-item\">\r\n        <div @click=\"goToAttractionDetail(favorite.attraction)\">\r\n          <img :src=\"getImage(favorite.attraction)\" alt=\"attraction image\" class=\"favorite-image\" />\r\n          <div class=\"favorite-info\">\r\n            <h3>{{ getAttractionName(favorite.attraction) }}</h3>\r\n            <p>{{ getAttractionDescription(favorite.attraction) }}</p>\r\n          </div>\r\n        </div>\r\n        <button @click=\"removeFavorite(favorite.attraction)\" class=\"remove-button\">取消收藏</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'FavoritesPage',\r\n  data() {\r\n    return {\r\n      favorites: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFavorites();\r\n  },\r\n  methods: {\r\n    async fetchFavorites() {\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.favorites = response.data;\r\n      } catch (error) {\r\n        console.error('获取收藏失败:', error);\r\n      }\r\n    },\r\n    async removeFavorite(attractionId) {\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        await axios.delete(`http://127.0.0.1:8000/api/favorites/${attractionId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.fetchFavorites();\r\n      } catch (error) {\r\n        console.error('取消收藏失败:', error);\r\n      }\r\n    },\r\n    goToAttractionDetail(attractionId) {\r\n      this.$router.push(`/attractions/${attractionId}`);\r\n    },\r\n    getImage(attractionId) {\r\n      const attraction = this.$store.state.attractions.find(a => a.id === attractionId);\r\n      return attraction ? attraction.images[0].image : '';\r\n    },\r\n    getAttractionName(attractionId) {\r\n      const attraction = this.$store.state.attractions.find(a => a.id === attractionId);\r\n      return attraction ? attraction.name : '';\r\n    },\r\n    getAttractionDescription(attractionId) {\r\n      const attraction = this.$store.state.attractions.find(a => a.id === attractionId);\r\n      return attraction ? (attraction.description.length > 100 ? attraction.description.substring(0, 100) + '...' : attraction.description) : '';\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.favorites {\r\n  padding: 20px;\r\n}\r\n.favorites-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.favorite-item {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n}\r\n.favorite-item:hover {\r\n  background-color: #f9f9f9;\r\n}\r\n.favorite-image {\r\n  width: 100px;\r\n  height: auto;\r\n  margin-right: 10px;\r\n}\r\n.favorite-info {\r\n  flex-grow: 1;\r\n}\r\n.remove-button {\r\n  background-color: #d9534f;\r\n  color: white;\r\n  border: none;\r\n  padding: 5px 10px;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n.remove-button:hover {\r\n  background-color: #c9302c;\r\n}\r\n</style>\r\n"],"mappings":";AAmBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAD,eAAA;MACA,MAAAE,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MA