{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'SetRouteAttractions',\n  data() {\n    return {\n      routeId: null,\n      searchQuery: '',\n      searchResults: [],\n      routeAttractions: [],\n      isRouteEnded: false\n    };\n  },\n  created() {\n    this.routeId = this.$route.params.routeId;\n  },\n  methods: {\n    async searchAttractions() {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/attractions/', {\n          params: {\n            q: this.searchQuery\n          }\n        });\n        this.searchResults = response.data;\n      } catch (error) {\n        console.error('搜索景点失败:', error);\n      }\n    },\n    cancelSearch() {\n      this.searchResults = [];\n    },\n    async addAttraction(attractionId) {\n      this.routeAttractions.push(this.searchResults.find(attraction => attraction.id === attractionId));\n      this.cancelSearch();\n    },\n    startSearch() {\n      this.isRouteEnded = false;\n    },\n    async submitRouteAttractions() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        for (const attraction of this.routeAttractions) {\n          await axios.post('http://127.0.0.1:8000/api/rt_at/', {\n            rt_id: this.routeId,\n            at_id: attraction.id\n          }, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n        }\n        alert('线路景点提交成功');\n        this.$router.push({\n          name: 'SetRouteDates',\n          params: {\n            routeId: this.routeId\n          }\n        });\n      } catch (error) {\n        console.error('提交线路景点失败:', error);\n        alert('提交线路景点失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","routeId","searchQuery","searchResults","routeAttractions","isRouteEnded","created","$route","params","methods","searchAttractions","response","get","q","error","console","cancelSearch","addAttraction","attractionId","push","find","attraction","id","startSearch","submitRouteAttractions","token","localStorage","getItem","alert","post","rt_id","at_id","headers","$router"],"sources":["src/components/SetRouteAttractions.vue"],"sourcesContent":["<template>\r\n  <div class=\"set-route-attractions\">\r\n    <h1>设置线路景点</h1>\r\n    <div class=\"form-group\">\r\n      <label for=\"searchAttractions\">搜索景点:</label>\r\n      <input id=\"searchAttractions\" v-model=\"searchQuery\" placeholder=\"输入景点名称或地址\" @keyup.enter=\"searchAttractions\">\r\n      <button @click=\"searchAttractions\">搜索</button>\r\n      <button @click=\"cancelSearch\">取消搜索</button>\r\n    </div>\r\n    <div v-if=\"searchResults.length > 0\">\r\n      <ul>\r\n        <li v-for=\"attraction in searchResults\" :key=\"attraction.id\">\r\n          <div @click=\"addAttraction(attraction.id)\">\r\n            {{ attraction.name }} - {{ attraction.address }}\r\n          </div>\r\n        </li>\r\n      </ul>\r\n    </div>\r\n    <div class=\"route-map\">\r\n      <h2>线路图</h2>\r\n      <ul>\r\n        <li v-for=\"attraction in routeAttractions\" :key=\"attraction.id\">\r\n          {{ attraction.name }}\r\n        </li>\r\n      </ul>\r\n      <div v-if=\"!isRouteEnded\" @click=\"startSearch\" class=\"add-attraction\">+ 添加景点</div>\r\n    </div>\r\n    <button @click=\"submitRouteAttractions\" class=\"submit-button\">提交线路景点</button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'SetRouteAttractions',\r\n  data() {\r\n    return {\r\n      routeId: null,\r\n      searchQuery: '',\r\n      searchResults: [],\r\n      routeAttractions: [],\r\n      isRouteEnded: false\r\n    };\r\n  },\r\n  created() {\r\n    this.routeId = this.$route.params.routeId;\r\n  },\r\n  methods: {\r\n    async searchAttractions() {\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/attractions/', {\r\n          params: { q: this.searchQuery }\r\n        });\r\n        this.searchResults = response.data;\r\n      } catch (error) {\r\n        console.error('搜索景点失败:', error);\r\n      }\r\n    },\r\n    cancelSearch() {\r\n      this.searchResults = [];\r\n    },\r\n    async addAttraction(attractionId) {\r\n      this.routeAttractions.push(this.searchResults.find(attraction => attraction.id === attractionId));\r\n      this.cancelSearch();\r\n    },\r\n    startSearch() {\r\n      this.isRouteEnded = false;\r\n    },\r\n    async submitRouteAttractions() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        for (const attraction of this.routeAttractions) {\r\n          await axios.post('http://127.0.0.1:8000/api/rt_at/', {\r\n            rt_id: this.routeId,\r\n            at_id: attraction.id\r\n          }, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n        }\r\n        alert('线路景点提交成功');\r\n        this.$router.push({ name: 'SetRouteDates', params: { routeId: this.routeId } });\r\n      } catch (error) {\r\n        console.error('提交线路景点失败:', error);\r\n        alert('提交线路景点失败');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.set-route-attractions {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: calc(100% - 100px);\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.form-group button {\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.route-map {\r\n  margin-top: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.route-map h2 {\r\n  font-size: 1.5em;\r\n}\r\n\r\n.route-map ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.route-map li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n\r\n.add-attraction {\r\n  display: inline-block;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  cursor: pointer;\r\n  margin-top: 10px;\r\n}\r\n\r\n.add-attraction:hover {\r\n  background-color: #368f6a;\r\n}\r\n\r\n.submit-button {\r\n  margin-top: 20px;\r\n  width: 100%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.submit-button:hover {\r\n  background-color: #368f6a;\r\n}\r\n</style>\r\n"],"mappings":";AAgCA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,WAAA;MACAC,aAAA;MACAC,gBAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAL,OAAA,QAAAM,MAAA,CAAAC,MAAA,CAAAP,OAAA;EACA;EACAQ,OAAA;IACA,MAAAC,kBAAA;MACA;QACA,MAAAC,QAAA,SAAAb,KAAA,CAAAc,GAAA;UACAJ,MAAA;YAAAK,CAAA,OAAAX;UAAA;QACA;QACA,KAAAC,aAAA,GAAAQ,QAAA,CAAAX,IAAA;MACA,SAAAc,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,aAAA;MACA,KAAAb,aAAA;IACA;IACA,MAAAc,cAAAC,YAAA;MACA,KAAAd,gBAAA,CAAAe,IAAA,MAAAhB,aAAA,CAAAiB,IAAA,CAAAC,UAAA,IAAAA,UAAA,CAAAC,EAAA,KAAAJ,YAAA;MACA,KAAAF,YAAA;IACA;IACAO,YAAA;MACA,KAAAlB,YAAA;IACA;IACA,MAAAmB,uBAAA;MACA,MAAAC,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAG,KAAA;QACA;MACA;MAEA;QACA,WAAAP,UAAA,SAAAjB,gBAAA;UACA,MAAAN,KAAA,CAAA+B,IAAA;YACAC,KAAA,OAAA7B,OAAA;YACA8B,KAAA,EAAAV,UAAA,CAAAC;UACA;YACAU,OAAA;cACA,0BAAAP,KAAA;YACA;UACA;QACA;QACAG,KAAA;QACA,KAAAK,OAAA,CAAAd,IAAA;UAAApB,IAAA;UAAAS,MAAA;YAAAP,OAAA,OAAAA;UAAA;QAAA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;QACAc,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}