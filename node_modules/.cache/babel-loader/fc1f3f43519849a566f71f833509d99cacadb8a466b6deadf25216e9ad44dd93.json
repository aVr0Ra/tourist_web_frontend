{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'AttractionDetail',\n  data() {\n    return {\n      attraction: null,\n      comments: [],\n      newCommentText: '',\n      newRating: 5.0,\n      newImages: [],\n      currentPage: 1,\n      commentsPerPage: 10\n    };\n  },\n  created() {\n    this.fetchAttractionDetails();\n    this.fetchComments();\n  },\n  methods: {\n    async fetchAttractionDetails() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}`);\n        this.attraction = response.data;\n      } catch (error) {\n        console.error('获取景点详情失败:', error);\n      }\n    },\n    async fetchComments() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/comments`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败:', error);\n      }\n    },\n    handleImageUpload(event) {\n      this.newImages = Array.from(event.target.files);\n    },\n    confirmSubmitComment() {\n      const confirmed = window.confirm('确认提交吗？提交之后的评论将匿名且不可修改！');\n      if (confirmed) {\n        this.postComment();\n      }\n    },\n    async postComment() {\n      const token = localStorage.getItem('token');\n      if (!this.newCommentText || !this.newRating || !token) {\n        alert('请填写所有字段并确保已登录');\n        return;\n      }\n      const formData = new FormData();\n      formData.append('attraction', this.$route.params.id);\n      formData.append('comment_text', this.newCommentText);\n      formData.append('rating', this.newRating);\n      formData.append('is_featured', false);\n      this.newImages.forEach(image => {\n        formData.append('images', image);\n      });\n      try {\n        await axios.post('http://127.0.0.1:8000/api/comments/', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data',\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.newCommentText = '';\n        this.newRating = 5.0;\n        this.newImages = [];\n        this.$router.go(0); // 刷新页面\n      } catch (error) {\n        console.error('发表评论失败:', error.response.data);\n      }\n    },\n    prevPage() {\n      if (this.currentPage > 1) {\n        this.currentPage--;\n      }\n    },\n    nextPage() {\n      if (this.currentPage < this.totalPages) {\n        this.currentPage++;\n      }\n    }\n  },\n  computed: {\n    paginatedComments() {\n      const start = (this.currentPage - 1) * this.commentsPerPage;\n      const end = start + this.commentsPerPage;\n      return this.comments.slice(start, end);\n    },\n    totalPages() {\n      return Math.ceil(this.comments.length / this.commentsPerPage);\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","attraction","comments","newCommentText","newRating","newImages","currentPage","commentsPerPage","created","fetchAttractionDetails","fetchComments","methods","attractionId","$route","params","id","response","get","error","console","handleImageUpload","event","Array","from","target","files","confirmSubmitComment","confirmed","window","confirm","postComment","token","localStorage","getItem","alert","formData","FormData","append","forEach","image","post","headers","$router","go","prevPage","nextPage","totalPages","computed","paginatedComments","start","end","slice","Math","ceil","length"],"sources":["src/components/AttractionDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"attraction-detail\">\r\n    <h1>{{ attraction.name }}</h1>\r\n    <img :src=\"attraction.images[0].image\" :alt=\"attraction.name\" class=\"attraction-image\">\r\n    <p><strong>星级:</strong> {{ attraction.star_level }}</p>\r\n    <p><strong>评分:</strong> {{ attraction.rating }}</p>\r\n    <p><strong>描述:</strong> {{ attraction.description }}</p>\r\n    <p><strong>开放时间:</strong> {{ attraction.opening_hours }}</p>\r\n    <p><strong>地址:</strong> {{ attraction.address }}</p>\r\n    <p><strong>联系电话:</strong> {{ attraction.official_phone }}</p>\r\n    <p><strong>人气:</strong> {{ attraction.popularity }}</p>\r\n    <p><strong>评论数:</strong> {{ attraction.comment_count }}</p>\r\n\r\n    <div class=\"comments\">\r\n      <h2>评论区</h2>\r\n      <div class=\"new-comment\">\r\n        <textarea v-model=\"newCommentText\" placeholder=\"发表评论\"></textarea>\r\n        <div>\r\n          <label for=\"rating\">评分: {{ newRating }}</label>\r\n          <input type=\"range\" id=\"rating\" v-model=\"newRating\" min=\"0.0\" max=\"9.9\" step=\"0.1\">\r\n        </div>\r\n        <input type=\"file\" @change=\"handleImageUpload\" multiple>\r\n        <button @click=\"confirmSubmitComment\">提交评论</button>\r\n      </div>\r\n      <ul>\r\n        <li v-for=\"comment in paginatedComments\" :key=\"comment.id\">\r\n          <p class=\"comment-rating\">{{ comment.rating }}/10分</p>\r\n          <p class=\"comment-text\">{{ comment.comment_text }}</p>\r\n          <img v-if=\"comment.images.length\" :src=\"comment.images[0].image_url\" :alt=\"comment.comment_text\" class=\"comment-image\">\r\n          <p class=\"comment-date\">发表于: {{ new Date(comment.created_at).toLocaleString() }}</p>\r\n        </li>\r\n      </ul>\r\n      <div class=\"pagination\">\r\n        <button @click=\"prevPage\" :disabled=\"currentPage === 1\">上一页</button>\r\n        <span>第 {{ currentPage }} 页，共 {{ totalPages }} 页</span>\r\n        <button @click=\"nextPage\" :disabled=\"currentPage === totalPages\">下一页</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'AttractionDetail',\r\n  data() {\r\n    return {\r\n      attraction: null,\r\n      comments: [],\r\n      newCommentText: '',\r\n      newRating: 5.0,\r\n      newImages: [],\r\n      currentPage: 1,\r\n      commentsPerPage: 10\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAttractionDetails();\r\n    this.fetchComments();\r\n  },\r\n  methods: {\r\n    async fetchAttractionDetails() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}`);\r\n        this.attraction = response.data;\r\n      } catch (error) {\r\n        console.error('获取景点详情失败:', error);\r\n      }\r\n    },\r\n    async fetchComments() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/comments`);\r\n        this.comments = response.data;\r\n      } catch (error) {\r\n        console.error('获取评论失败:', error);\r\n      }\r\n    },\r\n    handleImageUpload(event) {\r\n      this.newImages = Array.from(event.target.files);\r\n    },\r\n    confirmSubmitComment() {\r\n      const confirmed = window.confirm('确认提交吗？提交之后的评论将匿名且不可修改！');\r\n      if (confirmed) {\r\n        this.postComment();\r\n      }\r\n    },\r\n    async postComment() {\r\n      const token = localStorage.getItem('token');\r\n      if (!this.newCommentText || !this.newRating || !token) {\r\n        alert('请填写所有字段并确保已登录');\r\n        return;\r\n      }\r\n\r\n      const formData = new FormData();\r\n      formData.append('attraction', this.$route.params.id);\r\n      formData.append('comment_text', this.newCommentText);\r\n      formData.append('rating', this.newRating);\r\n      formData.append('is_featured', false);\r\n      this.newImages.forEach(image => {\r\n        formData.append('images', image);\r\n      });\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/comments/', formData, {\r\n          headers: {\r\n            'Content-Type': 'multipart/form-data',\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.newCommentText = '';\r\n        this.newRating = 5.0;\r\n        this.newImages = [];\r\n        this.$router.go(0);  // 刷新页面\r\n      } catch (error) {\r\n        console.error('发表评论失败:', error.response.data);\r\n      }\r\n    },\r\n    prevPage() {\r\n      if (this.currentPage > 1) {\r\n        this.currentPage--;\r\n      }\r\n    },\r\n    nextPage() {\r\n      if (this.currentPage < this.totalPages) {\r\n        this.currentPage++;\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    paginatedComments() {\r\n      const start = (this.currentPage - 1) * this.commentsPerPage;\r\n      const end = start + this.commentsPerPage;\r\n      return this.comments.slice(start, end);\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.comments.length / this.commentsPerPage);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.attraction-detail {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  text-align: left;\r\n}\r\n.attraction-image {\r\n  width: 100%;\r\n  height: auto;\r\n}\r\n.comments {\r\n  margin-top: 20px;\r\n}\r\n.new-comment {\r\n  margin-bottom: 20px;\r\n}\r\n.new-comment textarea {\r\n  width: 100%;\r\n  height: 100px;\r\n}\r\n.new-comment input[type=\"range\"] {\r\n  width: 100%;\r\n  margin-top: 10px;\r\n}\r\n.new-comment input[type=\"file\"] {\r\n  margin-top: 10px;\r\n}\r\n.new-comment button {\r\n  margin-top: 10px;\r\n}\r\n.comments ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n.comments li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n.comment-rating {\r\n  font-size: 1.2em;\r\n  font-weight: bold;\r\n}\r\n.comment-text {\r\n  font-size: 1em;\r\n}\r\n.comment-image {\r\n  width: 100px; /* Reduced size */\r\n  height: auto;\r\n  margin-top: 10px;\r\n}\r\n.comment-date {\r\n  font-size: 0.8em;\r\n  color: #777;\r\n}\r\n.pagination {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 20px;\r\n}\r\n.pagination button {\r\n  padding: 5px 10px;\r\n  font-size: 1em;\r\n}\r\n</style>\r\n"],"mappings":"AA0CA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,QAAA;MACAC,cAAA;MACAC,SAAA;MACAC,SAAA;MACAC,WAAA;MACAC,eAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,sBAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAF,uBAAA;MACA,MAAAG,YAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA;QACA,MAAAC,QAAA,SAAAlB,KAAA,CAAAmB,GAAA,0CAAAL,YAAA;QACA,KAAAX,UAAA,GAAAe,QAAA,CAAAhB,IAAA;MACA,SAAAkB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAR,cAAA;MACA,MAAAE,YAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA;QACA,MAAAC,QAAA,SAAAlB,KAAA,CAAAmB,GAAA,0CAAAL,YAAA;QACA,KAAAV,QAAA,GAAAc,QAAA,CAAAhB,IAAA;MACA,SAAAkB,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,kBAAAC,KAAA;MACA,KAAAhB,SAAA,GAAAiB,KAAA,CAAAC,IAAA,CAAAF,KAAA,CAAAG,MAAA,CAAAC,KAAA;IACA;IACAC,qBAAA;MACA,MAAAC,SAAA,GAAAC,MAAA,CAAAC,OAAA;MACA,IAAAF,SAAA;QACA,KAAAG,WAAA;MACA;IACA;IACA,MAAAA,YAAA;MACA,MAAAC,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,UAAA9B,cAAA,UAAAC,SAAA,KAAA2B,KAAA;QACAG,KAAA;QACA;MACA;MAEA,MAAAC,QAAA,OAAAC,QAAA;MACAD,QAAA,CAAAE,MAAA,oBAAAxB,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACAoB,QAAA,CAAAE,MAAA,sBAAAlC,cAAA;MACAgC,QAAA,CAAAE,MAAA,gBAAAjC,SAAA;MACA+B,QAAA,CAAAE,MAAA;MACA,KAAAhC,SAAA,CAAAiC,OAAA,CAAAC,KAAA;QACAJ,QAAA,CAAAE,MAAA,WAAAE,KAAA;MACA;MAEA;QACA,MAAAzC,KAAA,CAAA0C,IAAA,wCAAAL,QAAA;UACAM,OAAA;YACA;YACA,0BAAAV,KAAA;UACA;QACA;QACA,KAAA5B,cAAA;QACA,KAAAC,SAAA;QACA,KAAAC,SAAA;QACA,KAAAqC,OAAA,CAAAC,EAAA;MACA,SAAAzB,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA,CAAAF,QAAA,CAAAhB,IAAA;MACA;IACA;IACA4C,SAAA;MACA,SAAAtC,WAAA;QACA,KAAAA,WAAA;MACA;IACA;IACAuC,SAAA;MACA,SAAAvC,WAAA,QAAAwC,UAAA;QACA,KAAAxC,WAAA;MACA;IACA;EACA;EACAyC,QAAA;IACAC,kBAAA;MACA,MAAAC,KAAA,SAAA3C,WAAA,aAAAC,eAAA;MACA,MAAA2C,GAAA,GAAAD,KAAA,QAAA1C,eAAA;MACA,YAAAL,QAAA,CAAAiD,KAAA,CAAAF,KAAA,EAAAC,GAAA;IACA;IACAJ,WAAA;MACA,OAAAM,IAAA,CAAAC,IAAA,MAAAnD,QAAA,CAAAoD,MAAA,QAAA/C,eAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}