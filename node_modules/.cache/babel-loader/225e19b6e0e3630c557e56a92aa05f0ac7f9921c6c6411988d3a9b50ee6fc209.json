{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'SetRouteDates',\n  data() {\n    return {\n      routeId: null,\n      date: '',\n      days: 1,\n      limit: 1,\n      routeDates: []\n    };\n  },\n  created() {\n    this.routeId = this.$route.params.routeId;\n  },\n  methods: {\n    addRouteDate() {\n      if (this.date && this.days > 0 && this.limit > 0) {\n        this.routeDates.push({\n          rq: this.date,\n          days: this.days,\n          limit: this.limit\n        });\n        this.date = '';\n        this.days = 1;\n        this.limit = 1;\n      } else {\n        alert('请填写有效的时间、天数和人数上限');\n      }\n    },\n    async submitRouteDates() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        for (const routeDate of this.routeDates) {\n          await axios.post('http://127.0.0.1:8000/api/rt_rq/', {\n            rt_id: this.routeId,\n            rq: routeDate.rq,\n            days: routeDate.days,\n            limit: routeDate.limit\n          }, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n        }\n        alert('线路时间提交成功');\n        this.$router.push('/');\n      } catch (error) {\n        console.error('提交线路时间失败:', error);\n        alert('提交线路时间失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","routeId","date","days","limit","routeDates","created","$route","params","methods","addRouteDate","push","rq","alert","submitRouteDates","token","localStorage","getItem","routeDate","post","rt_id","headers","$router","error","console"],"sources":["src/components/SetRouteDates.vue"],"sourcesContent":["<template>\r\n  <div class=\"set-route-dates\">\r\n    <h1>设置线路时间</h1>\r\n    <form @submit.prevent=\"addRouteDate\">\r\n      <div class=\"form-group\">\r\n        <label for=\"date\">开始日期:</label>\r\n        <input type=\"date\" id=\"date\" v-model=\"date\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"days\">持续天数:</label>\r\n        <input type=\"number\" id=\"days\" v-model=\"days\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"limit\">人数上限:</label>\r\n        <input type=\"number\" id=\"limit\" v-model=\"limit\" required>\r\n      </div>\r\n      <button type=\"submit\" class=\"add-button\">添加时间</button>\r\n    </form>\r\n    <ul class=\"route-dates-list\">\r\n      <li v-for=\"(date, index) in routeDates\" :key=\"index\">\r\n        {{ date.rq }} - {{ date.days }} 天 - 上限 {{ date.limit }} 人\r\n      </li>\r\n    </ul>\r\n    <button @click=\"submitRouteDates\" class=\"submit-button\">提交线路时间</button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'SetRouteDates',\r\n  data() {\r\n    return {\r\n      routeId: null,\r\n      date: '',\r\n      days: 1,\r\n      limit: 1,\r\n      routeDates: []\r\n    };\r\n  },\r\n  created() {\r\n    this.routeId = this.$route.params.routeId;\r\n  },\r\n  methods: {\r\n    addRouteDate() {\r\n      if (this.date && this.days > 0 && this.limit > 0) {\r\n        this.routeDates.push({ rq: this.date, days: this.days, limit: this.limit });\r\n        this.date = '';\r\n        this.days = 1;\r\n        this.limit = 1;\r\n      } else {\r\n        alert('请填写有效的时间、天数和人数上限');\r\n      }\r\n    },\r\n    async submitRouteDates() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        for (const routeDate of this.routeDates) {\r\n          await axios.post('http://127.0.0.1:8000/api/rt_rq/', {\r\n            rt_id: this.routeId,\r\n            rq: routeDate.rq,\r\n            days: routeDate.days,\r\n            limit: routeDate.limit\r\n          }, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n        }\r\n        alert('线路时间提交成功');\r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        console.error('提交线路时间失败:', error);\r\n        alert('提交线路时间失败');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.set-route-dates {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n\r\n.add-button {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.submit-button {\r\n  margin-top: 20px;\r\n  width: 100%;\r\n}\r\n\r\n.route-dates-list {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.route-dates-list li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n</style>\r\n"],"mappings":";AA4BA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,IAAA;MACAC,IAAA;MACAC,KAAA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAL,OAAA,QAAAM,MAAA,CAAAC,MAAA,CAAAP,OAAA;EACA;EACAQ,OAAA;IACAC,aAAA;MACA,SAAAR,IAAA,SAAAC,IAAA,aAAAC,KAAA;QACA,KAAAC,UAAA,CAAAM,IAAA;UAAAC,EAAA,OAAAV,IAAA;UAAAC,IAAA,OAAAA,IAAA;UAAAC,KAAA,OAAAA;QAAA;QACA,KAAAF,IAAA;QACA,KAAAC,IAAA;QACA,KAAAC,KAAA;MACA;QACAS,KAAA;MACA;IACA;IACA,MAAAC,iBAAA;MACA,MAAAC,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAF,KAAA;QACA;MACA;MAEA;QACA,WAAAK,SAAA,SAAAb,UAAA;UACA,MAAAP,KAAA,CAAAqB,IAAA;YACAC,KAAA,OAAAnB,OAAA;YACAW,EAAA,EAAAM,SAAA,CAAAN,EAAA;YACAT,IAAA,EAAAe,SAAA,CAAAf,IAAA;YACAC,KAAA,EAAAc,SAAA,CAAAd;UACA;YACAiB,OAAA;cACA,0BAAAN,KAAA;YACA;UACA;QACA;QACAF,KAAA;QACA,KAAAS,OAAA,CAAAX,IAAA;MACA,SA