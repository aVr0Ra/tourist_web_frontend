{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'RegisterPage',\n  data() {\n    return {\n      username: '',\n      password: '',\n      confirmPassword: '',\n      firstName: '',\n      lastName: '',\n      email: ''\n    };\n  },\n  methods: {\n    async register() {\n      if (this.password !== this.confirmPassword) {\n        alert('密码不匹配');\n        return;\n      }\n      const payload = {\n        user: {\n          username: this.username,\n          password: this.password,\n          password2: this.confirmPassword,\n          first_name: this.firstName,\n          last_name: this.lastName,\n          email: this.email\n        },\n        avatar: null,\n        user_type: 'regular'\n      };\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/register/', payload, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        console.log('注册成功:', response.data);\n        // 可以在这里处理成功注册后的操作，例如跳转到登录页面\n      } catch (error) {\n        console.error('注册失败:', error.response.data);\n        // 可以在这里处理注册失败后的操作，例如显示错误消息\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","username","password","confirmPassword","firstName","lastName","email","methods","register","alert","payload","user","password2","first_name","last_name","avatar","user_type","response","post","headers","console","log","error"],"sources":["src/components/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"auth-page\">\r\n    <h2>注册</h2>\r\n    <form @submit.prevent=\"register\">\r\n      <div>\r\n        <label for=\"username\">用户名:</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">密码:</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"confirmPassword\">确认密码:</label>\r\n        <input type=\"password\" id=\"confirmPassword\" v-model=\"confirmPassword\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"firstName\">名字:</label>\r\n        <input type=\"text\" id=\"firstName\" v-model=\"firstName\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"lastName\">姓氏:</label>\r\n        <input type=\"text\" id=\"lastName\" v-model=\"lastName\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"email\">电子邮箱:</label>\r\n        <input type=\"email\" id=\"email\" v-model=\"email\" required>\r\n      </div>\r\n      <button type=\"submit\">注册</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: '',\r\n      confirmPassword: '',\r\n      firstName: '',\r\n      lastName: '',\r\n      email: ''\r\n    };\r\n  },\r\n  methods: {\r\n    async register() {\r\n      if (this.password !== this.confirmPassword) {\r\n        alert('密码不匹配');\r\n        return;\r\n      }\r\n\r\n      const payload = {\r\n        user: {\r\n          username: this.username,\r\n          password: this.password,\r\n          password2: this.confirmPassword,\r\n          first_name: this.firstName,\r\n          last_name: this.lastName,\r\n          email: this.email\r\n        },\r\n        avatar: null,\r\n        user_type: 'regular'\r\n      };\r\n\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/register/', payload, {\r\n          headers: {\r\n            'Content-Type': 'application/json'\r\n          }\r\n        });\r\n        console.log('注册成功:', response.data);\r\n        // 可以在这里处理成功注册后的操作，例如跳转到登录页面\r\n      } catch (error) {\r\n        console.error('注册失败:', error.response.data);\r\n        // 可以在这里处理注册失败后的操作，例如显示错误消息\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.auth-page {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\nform div {\r\n  margin-bottom: 15px;\r\n}\r\nform label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\nform input {\r\n  width: 100%;\r\n  padding: 8px;\r\n  box-sizing: border-box;\r\n}\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\nbutton:hover {\r\n  background-color: #42b983;\r\n  color: white;\r\n}\r\n</style>\r\n"],"mappings":"AAkCA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;MACAC,eAAA;MACAC,SAAA;MACAC,QAAA;MACAC,KAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,SAAA;MACA,SAAAN,QAAA,UAAAC,eAAA;QACAM,KAAA;QACA;MACA;MAEA,MAAAC,OAAA;QACAC,IAAA;UACAV,QAAA,OAAAA,QAAA;UACAC,QAAA,OAAAA,QAAA;UACAU,SAAA,OAAAT,eAAA;UACAU,UAAA,OAAAT,SAAA;UACAU,SAAA,OAAAT,QAAA;UACAC,KAAA,OAAAA;QACA;QACAS,MAAA;QACAC,SAAA;MACA;MAEA;QACA,MAAAC,QAAA,SAAAnB,KAAA,CAAAoB,IAAA,wCAAAR,OAAA;UACAS,OAAA;YACA;UACA;QACA;QACAC,OAAA,CAAAC,GAAA,UAAAJ,QAAA,CAAAjB,IAAA;QACA;MACA,SAAAsB,KAAA;QACAF,OAAA,CAAAE,KAAA,UAAAA,KAAA,CAAAL,QAAA,CAAAjB,IAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}