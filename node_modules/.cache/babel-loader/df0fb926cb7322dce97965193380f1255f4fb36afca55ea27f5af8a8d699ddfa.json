{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nimport moment from 'moment';\nexport default {\n  name: 'ReserveRoute',\n  data() {\n    return {\n      profile: null,\n      route: null,\n      schedule: null\n    };\n  },\n  created() {\n    this.fetchProfile();\n    this.fetchRouteDetails();\n    this.fetchScheduleDetails();\n  },\n  methods: {\n    async fetchProfile() {\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.profile = response.data.user;\n      } catch (error) {\n        console.error('获取个人资料失败:', error);\n      }\n    },\n    async fetchRouteDetails() {\n      const routeId = this.$route.params.routeId;\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${routeId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.route = response.data;\n      } catch (error) {\n        console.error('获取路线详情失败:', error);\n      }\n    },\n    async fetchScheduleDetails() {\n      const scheduleId = this.$route.params.scheduleId;\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_rq/${scheduleId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.schedule = response.data;\n      } catch (error) {\n        console.error('获取时间详情失败:', error);\n      }\n    },\n    async confirmReservation() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      const reservationData = {\n        rv_date: moment().format('YYYY-MM-DD'),\n        tr_id: this.profile.id,\n        rt_rq_id: this.schedule.id,\n        status: true\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/reservations/', reservationData, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        alert('预约成功');\n        this.$router.push('/');\n      } catch (error) {\n        console.error('预约失败:', error);\n        alert('预约失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","moment","name","data","profile","route","schedule","created","fetchProfile","fetchRouteDetails","fetchScheduleDetails","methods","token","localStorage","getItem","response","get","headers","user","error","console","routeId","$route","params","scheduleId","confirmReservation","alert","reservationData","rv_date","format","tr_id","id","rt_rq_id","status","post","$router","push"],"sources":["src/components/ReserveRoute.vue"],"sourcesContent":["<template>\r\n  <div class=\"reserve-route\">\r\n    <h1>确认预约</h1>\r\n    <p><strong>用户名:</strong> {{ profile.username }}</p>\r\n    <p><strong>路线名称:</strong> {{ route.rt_name }}</p>\r\n    <p><strong>路线简介:</strong> {{ route.rt_brief }}</p>\r\n    <p><strong>路线价格:</strong> {{ route.price }}</p>\r\n    <p><strong>开始时间:</strong> {{ schedule.rq }}</p>\r\n    <button @click=\"confirmReservation\">确认预约</button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport moment from 'moment';\r\n\r\nexport default {\r\n  name: 'ReserveRoute',\r\n  data() {\r\n    return {\r\n      profile: null,\r\n      route: null,\r\n      schedule: null\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchProfile();\r\n    this.fetchRouteDetails();\r\n    this.fetchScheduleDetails();\r\n  },\r\n  methods: {\r\n    async fetchProfile() {\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.profile = response.data.user;\r\n      } catch (error) {\r\n        console.error('获取个人资料失败:', error);\r\n      }\r\n    },\r\n    async fetchRouteDetails() {\r\n      const routeId = this.$route.params.routeId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${routeId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.route = response.data;\r\n      } catch (error) {\r\n        console.error('获取路线详情失败:', error);\r\n      }\r\n    },\r\n    async fetchScheduleDetails() {\r\n      const scheduleId = this.$route.params.scheduleId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_rq/${scheduleId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.schedule = response.data;\r\n      } catch (error) {\r\n        console.error('获取时间详情失败:', error);\r\n      }\r\n    },\r\n    async confirmReservation() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      const reservationData = {\r\n        rv_date: moment().format('YYYY-MM-DD'),\r\n        tr_id: this.profile.id,\r\n        rt_rq_id: this.schedule.id,\r\n        status: true\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/reservations/', reservationData, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        alert('预约成功');\r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        console.error('预约失败:', error);\r\n        alert('预约失败');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.reserve-route {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\np {\r\n  text-align: left;\r\n  margin: 10px 0;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  margin-top: 20px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n</style>\r\n"],"mappings":";AAaA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,KAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,YAAA;IACA,KAAAC,iBAAA;IACA,KAAAC,oBAAA;EACA;EACAC,OAAA;IACA,MAAAH,aAAA;MACA,MAAAI,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAAf,KAAA,CAAAgB,GAAA;UACAC,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAR,OAAA,GAAAW,QAAA,CAAAZ,IAAA,CAAAe,IAAA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAV,kBAAA;MACA,MAAAY,OAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,OAAA;MACA,MAAAT,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAAf,KAAA,CAAAgB,GAAA,qCAAAK,OAAA;UACAJ,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAP,KAAA,GAAAU,QAAA,CAAAZ,IAAA;MACA,SAAAgB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAT,qBAAA;MACA,MAAAc,UAAA,QAAAF,MAAA,CAAAC,MAAA,CAAAC,UAAA;MACA,MAAAZ,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAAf,KAAA,CAAAgB,GAAA,oCAAAQ,UAAA;UACAP,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAN,QAAA,GAAAS,QAAA,CAAAZ,IAAA;MACA,SAAAgB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAM,mBAAA;MACA,MAAAb,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAc,KAAA;QACA;MACA;MAEA,MAAAC,eAAA;QACAC,OAAA,EAAA3B,MAAA,GAAA4B,MAAA;QACAC,KAAA,OAAA1B,OAAA,CAAA2B,EAAA;QACAC,QAAA,OAAA1B,QAAA,CAAAyB,EAAA;QACAE,MAAA;MACA;MAEA;QACA,MAAAjC,KAAA,CAAAkC,IAAA,4CAAAP,eAAA;UACAV,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACAc,KAAA;QACA,KAAAS,OAAA,CAAAC,IAAA;MACA,SAAAjB,KAAA;QACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;QACAO,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}