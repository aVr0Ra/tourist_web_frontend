{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'AttractionDetail',\n  data() {\n    return {\n      attraction: null,\n      comments: [],\n      newCommentText: '',\n      newRating: 5.0,\n      // 设置默认评分值\n      newImages: [],\n      currentPage: 1,\n      commentsPerPage: 10\n    };\n  },\n  created() {\n    this.fetchAttractionDetails();\n    this.fetchComments();\n  },\n  methods: {\n    async fetchAttractionDetails() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}`);\n        this.attraction = response.data;\n      } catch (error) {\n        console.error('获取景点详情失败:', error);\n      }\n    },\n    async fetchComments() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/comments`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败:', error);\n      }\n    },\n    handleImageUpload(event) {\n      const files = event.target.files;\n      for (let i = 0; i < files.length; i++) {\n        const reader = new FileReader();\n        reader.readAsDataURL(files[i]);\n        reader.onload = () => {\n          this.newImages.push({\n            image: reader.result.split(',')[1]\n          });\n        };\n      }\n    },\n    async confirmPostComment() {\n      if (confirm('确认提交评论吗？提交之后的评论将匿名且不可修改！')) {\n        this.postComment();\n      }\n    },\n    async postComment() {\n      const token = localStorage.getItem('token');\n      if (!this.newCommentText || !this.newRating || !token) {\n        alert('请填写所有字段并确保已登录');\n        return;\n      }\n      const payload = {\n        attraction: this.$route.params.id,\n        comment_text: this.newCommentText,\n        rating: this.newRating,\n        is_featured: false,\n        images: this.newImages.map(img => ({\n          image: img.image\n        }))\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/comments', payload, {\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.newCommentText = '';\n        this.newRating = 5.0; // 重置评分值\n        this.newImages = [];\n        this.fetchComments();\n      } catch (error) {\n        console.error('发表评论失败:', error);\n      }\n    },\n    prevPage() {\n      if (this.currentPage > 1) {\n        this.currentPage--;\n      }\n    },\n    nextPage() {\n      if (this.currentPage < this.totalPages) {\n        this.currentPage++;\n      }\n    }\n  },\n  computed: {\n    paginatedComments() {\n      const start = (this.currentPage - 1) * this.commentsPerPage;\n      const end = start + this.commentsPerPage;\n      return this.comments.slice(start, end);\n    },\n    totalPages() {\n      return Math.ceil(this.comments.length / this.commentsPerPage);\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","attraction","comments","newCommentText","newRating","newImages","currentPage","commentsPerPage","created","fetchAttractionDetails","fetchComments","methods","attractionId","$route","params","id","response","get","error","console","handleImageUpload","event","files","target","i","length","reader","FileReader","readAsDataURL","onload","push","image","result","split","confirmPostComment","confirm","postComment","token","localStorage","getItem","alert","payload","comment_text","rating","is_featured","images","map","img","post","headers","prevPage","nextPage","totalPages","computed","paginatedComments","start","end","slice","Math","ceil"],"sources":["src/components/AttractionDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"attraction-detail\">\r\n    <h1>{{ attraction.name }}</h1>\r\n    <img :src=\"attraction.images[0].image\" :alt=\"attraction.name\" class=\"attraction-image\">\r\n    <p><strong>星级:</strong> {{ attraction.star_level }}</p>\r\n    <p><strong>评分:</strong> {{ attraction.rating }}</p>\r\n    <p><strong>描述:</strong> {{ attraction.description }}</p>\r\n    <p><strong>开放时间:</strong> {{ attraction.opening_hours }}</p>\r\n    <p><strong>地址:</strong> {{ attraction.address }}</p>\r\n    <p><strong>联系电话:</strong> {{ attraction.official_phone }}</p>\r\n    <p><strong>人气:</strong> {{ attraction.popularity }}</p>\r\n    <p><strong>评论数:</strong> {{ attraction.comment_count }}</p>\r\n\r\n    <div class=\"comments\">\r\n      <h2>评论区</h2>\r\n      <div class=\"new-comment\">\r\n        <textarea v-model=\"newCommentText\" placeholder=\"发表评论\"></textarea>\r\n        <div class=\"slider-container\">\r\n          <label for=\"rating\">评分（0-9.9）:</label>\r\n          <input type=\"range\" id=\"rating\" v-model=\"newRating\" min=\"0\" max=\"9.9\" step=\"0.1\">\r\n          <span>{{ newRating }}</span>\r\n        </div>\r\n        <input type=\"file\" @change=\"handleImageUpload\" multiple>\r\n        <button @click=\"confirmPostComment\">提交评论</button>\r\n      </div>\r\n      <ul>\r\n        <li v-for=\"comment in paginatedComments\" :key=\"comment.id\">\r\n          <p class=\"comment-rating\">{{ comment.rating }}/10分</p>\r\n          <p class=\"comment-text\">{{ comment.comment_text }}</p>\r\n          <img v-if=\"comment.images.length\" :src=\"comment.images[0].image\" :alt=\"comment.comment_text\" class=\"comment-image\">\r\n          <p class=\"comment-date\">发表于: {{ new Date(comment.created_at).toLocaleString() }}</p>\r\n        </li>\r\n      </ul>\r\n      <div class=\"pagination\">\r\n        <button @click=\"prevPage\" :disabled=\"currentPage === 1\">上一页</button>\r\n        <span>第 {{ currentPage }} 页，共 {{ totalPages }} 页</span>\r\n        <button @click=\"nextPage\" :disabled=\"currentPage === totalPages\">下一页</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'AttractionDetail',\r\n  data() {\r\n    return {\r\n      attraction: null,\r\n      comments: [],\r\n      newCommentText: '',\r\n      newRating: 5.0, // 设置默认评分值\r\n      newImages: [],\r\n      currentPage: 1,\r\n      commentsPerPage: 10\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAttractionDetails();\r\n    this.fetchComments();\r\n  },\r\n  methods: {\r\n    async fetchAttractionDetails() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}`);\r\n        this.attraction = response.data;\r\n      } catch (error) {\r\n        console.error('获取景点详情失败:', error);\r\n      }\r\n    },\r\n    async fetchComments() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}/comments`);\r\n        this.comments = response.data;\r\n      } catch (error) {\r\n        console.error('获取评论失败:', error);\r\n      }\r\n    },\r\n    handleImageUpload(event) {\r\n      const files = event.target.files;\r\n      for (let i = 0; i < files.length; i++) {\r\n        const reader = new FileReader();\r\n        reader.readAsDataURL(files[i]);\r\n        reader.onload = () => {\r\n          this.newImages.push({ image: reader.result.split(',')[1] });\r\n        };\r\n      }\r\n    },\r\n    async confirmPostComment() {\r\n      if (confirm('确认提交评论吗？提交之后的评论将匿名且不可修改！')) {\r\n        this.postComment();\r\n      }\r\n    },\r\n    async postComment() {\r\n      const token = localStorage.getItem('token');\r\n      if (!this.newCommentText || !this.newRating || !token) {\r\n        alert('请填写所有字段并确保已登录');\r\n        return;\r\n      }\r\n\r\n      const payload = {\r\n        attraction: this.$route.params.id,\r\n        comment_text: this.newCommentText,\r\n        rating: this.newRating,\r\n        is_featured: false,\r\n        images: this.newImages.map(img => ({ image: img.image }))\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/comments', payload, {\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.newCommentText = '';\r\n        this.newRating = 5.0; // 重置评分值\r\n        this.newImages = [];\r\n        this.fetchComments();\r\n      } catch (error) {\r\n        console.error('发表评论失败:', error);\r\n      }\r\n    },\r\n    prevPage() {\r\n      if (this.currentPage > 1) {\r\n        this.currentPage--;\r\n      }\r\n    },\r\n    nextPage() {\r\n      if (this.currentPage < this.totalPages) {\r\n        this.currentPage++;\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    paginatedComments() {\r\n      const start = (this.currentPage - 1) * this.commentsPerPage;\r\n      const end = start + this.commentsPerPage;\r\n      return this.comments.slice(start, end);\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.comments.length / this.commentsPerPage);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.attraction-detail {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  text-align: left;\r\n}\r\n.attraction-image {\r\n  width: 100%;\r\n  height: auto;\r\n}\r\n.comments {\r\n  margin-top: 20px;\r\n}\r\n.new-comment {\r\n  margin-bottom: 20px;\r\n}\r\n.new-comment textarea {\r\n  width: 100%;\r\n  height: 100px;\r\n}\r\n.slider-container {\r\n  margin: 10px 0;\r\n}\r\n.slider-container label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n.new-comment input[type=\"file\"] {\r\n  margin-top: 10px;\r\n}\r\n.new-comment button {\r\n  margin-top: 10px;\r\n}\r\n.comments ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n.comments li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n.comment-rating {\r\n  font-size: 1.2em;\r\n  font-weight: bold;\r\n}\r\n.comment-text {\r\n  font-size: 1em;\r\n}\r\n.comment-image {\r\n  width: 500px;\r\n  height: auto;\r\n  margin-top: 10px;\r\n}\r\n.comment-date {\r\n  font-size: 0.8em;\r\n  color: #777;\r\n}\r\n.pagination {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 20px;\r\n}\r\n.pagination button {\r\n  padding: 5px 10px;\r\n  font-size: 1em;\r\n}\r\n</style>\r\n"],"mappings":";AA2CA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,QAAA;MACAC,cAAA;MACAC,SAAA;MAAA;MACAC,SAAA;MACAC,WAAA;MACAC,eAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,sBAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAF,uBAAA;MACA,MAAAG,YAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA;QACA,MAAAC,QAAA,SAAAlB,KAAA,CAAAmB,GAAA,0CAAAL,YAAA;QACA,KAAAX,UAAA,GAAAe,QAAA,CAAAhB,IAAA;MACA,SAAAkB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAR,cAAA;MACA,MAAAE,YAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA;QACA,MAAAC,QAAA,SAAAlB,KAAA,CAAAmB,GAAA,0CAAAL,YAAA;QACA,KAAAV,QAAA,GAAAc,QAAA,CAAAhB,IAAA;MACA,SAAAkB,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,kBAAAC,KAAA;MACA,MAAAC,KAAA,GAAAD,KAAA,CAAAE,MAAA,CAAAD,KAAA;MACA,SAAAE,CAAA,MAAAA,CAAA,GAAAF,KAAA,CAAAG,MAAA,EAAAD,CAAA;QACA,MAAAE,MAAA,OAAAC,UAAA;QACAD,MAAA,CAAAE,aAAA,CAAAN,KAAA,CAAAE,CAAA;QACAE,MAAA,CAAAG,MAAA;UACA,KAAAxB,SAAA,CAAAyB,IAAA;YAAAC,KAAA,EAAAL,MAAA,CAAAM,MAAA,CAAAC,KAAA;UAAA;QACA;MACA;IACA;IACA,MAAAC,mBAAA;MACA,IAAAC,OAAA;QACA,KAAAC,WAAA;MACA;IACA;IACA,MAAAA,YAAA;MACA,MAAAC,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,UAAApC,cAAA,UAAAC,SAAA,KAAAiC,KAAA;QACAG,KAAA;QACA;MACA;MAEA,MAAAC,OAAA;QACAxC,UAAA,OAAAY,MAAA,CAAAC,MAAA,CAAAC,EAAA;QACA2B,YAAA,OAAAvC,cAAA;QACAwC,MAAA,OAAAvC,SAAA;QACAwC,WAAA;QACAC,MAAA,OAAAxC,SAAA,CAAAyC,GAAA,CAAAC,GAAA;UAAAhB,KAAA,EAAAgB,GAAA,CAAAhB;QAAA;MACA;MAEA;QACA,MAAAjC,KAAA,CAAAkD,IAAA,uCAAAP,OAAA;UACAQ,OAAA;YACA;YACA,0BAAAZ,KAAA;UACA;QACA;QACA,KAAAlC,cAAA;QACA,KAAAC,SAAA;QACA,KAAAC,SAAA;QACA,KAAAK,aAAA;MACA,SAAAQ,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA