{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'RouteDetails',\n  data() {\n    return {\n      route: null,\n      attractions: [],\n      schedules: [],\n      showAddDateForm: false,\n      date: '',\n      days: 1,\n      limit: 1\n    };\n  },\n  created() {\n    this.fetchRouteDetails();\n    this.fetchAttractions();\n    this.fetchSchedules();\n  },\n  methods: {\n    async fetchRouteDetails() {\n      const routeId = this.$route.params.routeId;\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${routeId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.route = response.data;\n      } catch (error) {\n        console.error('获取线路详情失败:', error);\n      }\n    },\n    async fetchAttractions() {\n      const routeId = this.$route.params.routeId;\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_at/route/${routeId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.attractions = response.data;\n      } catch (error) {\n        console.error('获取线路经过景点失败:', error);\n      }\n    },\n    async fetchSchedules() {\n      const routeId = this.$route.params.routeId;\n      const token = localStorage.getItem('token');\n      try {\n        const schedulesResponse = await axios.get(`http://127.0.0.1:8000/api/rt_rq/route/${routeId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        const schedules = schedulesResponse.data;\n        for (const schedule of schedules) {\n          const reservationsResponse = await axios.get(`http://127.0.0.1:8000/api/reservations/route/${routeId}/`, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          const reservations = reservationsResponse.data.filter(reservation => reservation.rt_rq_id === schedule.id);\n          for (const reservation of reservations) {\n            const userResponse = await axios.get(`http://127.0.0.1:8000/api/profile/`, {\n              headers: {\n                'Authorization': `Token ${token}`\n              }\n            });\n            reservation.user = userResponse.data.user;\n          }\n          schedule.reservations = reservations;\n        }\n        this.schedules = schedules;\n      } catch (error) {\n        console.error('获取线路时间表失败:', error);\n      }\n    },\n    toggleAddDateForm() {\n      this.showAddDateForm = !this.showAddDateForm;\n    },\n    async addRouteDate() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      const routeDate = {\n        rt_id: this.route.id,\n        rq: this.date,\n        days: this.days,\n        limit: this.limit\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/rt_rq/', routeDate, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.date = '';\n        this.days = 1;\n        this.limit = 1;\n        this.fetchSchedules(); // Refresh schedules after adding\n        this.toggleAddDateForm(); // Hide the form after adding\n      } catch (error) {\n        console.error('添加线路日期失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","route","attractions","schedules","showAddDateForm","date","days","limit","created","fetchRouteDetails","fetchAttractions","fetchSchedules","methods","routeId","$route","params","token","localStorage","getItem","response","get","headers","error","console","schedulesResponse","schedule","reservationsResponse","reservations","filter","reservation","rt_rq_id","id","userResponse","user","toggleAddDateForm","addRouteDate","alert","routeDate","rt_id","rq","post"],"sources":["src/components/RouteDetails.vue"],"sourcesContent":["<template>\r\n  <div class=\"route-details\">\r\n    <h1>{{ route.rt_name }}</h1>\r\n    <p><strong>价格:</strong> {{ route.price }}</p>\r\n    <p><strong>简介:</strong> {{ route.rt_brief }}</p>\r\n    <h2>经过景点</h2>\r\n    <div class=\"attractions-list\">\r\n      <span v-for=\"(attraction, index) in attractions\" :key=\"attraction.id\">\r\n        {{ attraction.name }}\r\n        <span v-if=\"index < attractions.length - 1\"> -> </span>\r\n      </span>\r\n    </div>\r\n    <h2>已安排的时间表</h2>\r\n    <ul class=\"schedule-list\">\r\n      <li v-for=\"schedule in schedules\" :key=\"schedule.id\">\r\n        {{ schedule.rq }} - {{ schedule.days }} 天 - 上限 {{ schedule.limit }} 人\r\n        <ul>\r\n          <li v-for=\"reservation in schedule.reservations\" :key=\"reservation.id\">\r\n            <strong>预约用户:</strong> {{ reservation.user.username }} - 预约日期: {{ reservation.rv_date }}\r\n          </li>\r\n        </ul>\r\n      </li>\r\n    </ul>\r\n    <button @click=\"toggleAddDateForm\" v-if=\"!showAddDateForm\">添加新日期</button>\r\n    <form @submit.prevent=\"addRouteDate\" v-if=\"showAddDateForm\">\r\n      <div class=\"form-group\">\r\n        <label for=\"date\">开始日期:</label>\r\n        <input type=\"date\" id=\"date\" v-model=\"date\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"days\">持续天数:</label>\r\n        <input type=\"number\" id=\"days\" v-model=\"days\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"limit\">人数上限:</label>\r\n        <input type=\"number\" id=\"limit\" v-model=\"limit\" required>\r\n      </div>\r\n      <button type=\"submit\" class=\"add-button\">提交日期</button>\r\n      <button type=\"button\" @click=\"toggleAddDateForm\" class=\"cancel-button\">取消</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'RouteDetails',\r\n  data() {\r\n    return {\r\n      route: null,\r\n      attractions: [],\r\n      schedules: [],\r\n      showAddDateForm: false,\r\n      date: '',\r\n      days: 1,\r\n      limit: 1\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchRouteDetails();\r\n    this.fetchAttractions();\r\n    this.fetchSchedules();\r\n  },\r\n  methods: {\r\n    async fetchRouteDetails() {\r\n      const routeId = this.$route.params.routeId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/routes/${routeId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.route = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路详情失败:', error);\r\n      }\r\n    },\r\n    async fetchAttractions() {\r\n      const routeId = this.$route.params.routeId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/rt_at/route/${routeId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.attractions = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路经过景点失败:', error);\r\n      }\r\n    },\r\n    async fetchSchedules() {\r\n      const routeId = this.$route.params.routeId;\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const schedulesResponse = await axios.get(`http://127.0.0.1:8000/api/rt_rq/route/${routeId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        const schedules = schedulesResponse.data;\r\n\r\n        for (const schedule of schedules) {\r\n          const reservationsResponse = await axios.get(`http://127.0.0.1:8000/api/reservations/route/${routeId}/`, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n          const reservations = reservationsResponse.data.filter(\r\n            (reservation) => reservation.rt_rq_id === schedule.id\r\n          );\r\n\r\n          for (const reservation of reservations) {\r\n            const userResponse = await axios.get(`http://127.0.0.1:8000/api/profile/`, {\r\n              headers: {\r\n                'Authorization': `Token ${token}`\r\n              }\r\n            });\r\n            reservation.user = userResponse.data.user;\r\n          }\r\n\r\n          schedule.reservations = reservations;\r\n        }\r\n\r\n        this.schedules = schedules;\r\n      } catch (error) {\r\n        console.error('获取线路时间表失败:', error);\r\n      }\r\n    },\r\n    toggleAddDateForm() {\r\n      this.showAddDateForm = !this.showAddDateForm;\r\n    },\r\n    async addRouteDate() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      const routeDate = {\r\n        rt_id: this.route.id,\r\n        rq: this.date,\r\n        days: this.days,\r\n        limit: this.limit\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/rt_rq/', routeDate, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.date = '';\r\n        this.days = 1;\r\n        this.limit = 1;\r\n        this.fetchSchedules(); // Refresh schedules after adding\r\n        this.toggleAddDateForm(); // Hide the form after adding\r\n      } catch (error) {\r\n        console.error('添加线路日期失败:', error);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.route-details {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.attractions-list {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n  margin: 20px 0;\r\n}\r\n\r\n.schedule-list {\r\n  list-style-type: none;\r\n  padding: 0;\r\n}\r\n\r\n.schedule-list li {\r\n  margin: 10px 0;\r\n  background: #f9f9f9;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n  text-align: left;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  margin-right: 10px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n\r\n.add-button {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.cancel-button {\r\n  background-color: #d9534f;\r\n}\r\n\r\n.cancel-button:hover {\r\n  background-color: #c9302c;\r\n}\r\n\r\nul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\nul li {\r\n  background: #f9f9f9;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n</style>\r\n"],"mappings":"AA4CA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,KAAA;MACAC,WAAA;MACAC,SAAA;MACAC,eAAA;MACAC,IAAA;MACAC,IAAA;MACAC,KAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,iBAAA;IACA,KAAAC,gBAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAH,kBAAA;MACA,MAAAI,OAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,OAAA;MACA,MAAAG,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAArB,KAAA,CAAAsB,GAAA,qCAAAP,OAAA;UACAQ,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAf,KAAA,GAAAkB,QAAA,CAAAnB,IAAA;MACA,SAAAsB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAZ,iBAAA;MACA,MAAAG,OAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,OAAA;MACA,MAAAG,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAArB,KAAA,CAAAsB,GAAA,0CAAAP,OAAA;UACAQ,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAd,WAAA,GAAAiB,QAAA,CAAAnB,IAAA;MACA,SAAAsB,KAAA;QACAC,OAAA,CAAAD,KAAA,gBAAAA,KAAA;MACA;IACA;IACA,MAAAX,eAAA;MACA,MAAAE,OAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,OAAA;MACA,MAAAG,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAM,iBAAA,SAAA1B,KAAA,CAAAsB,GAAA,0CAAAP,OAAA;UACAQ,OAAA;YACA,0BAAAL,KAAA;UACA;QAC