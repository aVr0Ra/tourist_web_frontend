{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'App',\n  data() {\n    return {\n      isLoggedIn: !!localStorage.getItem('token')\n    };\n  },\n  computed: {\n    showAuthButtons() {\n      // 不在登录和注册页面显示按钮\n      return !['/login', '/register'].includes(this.$route.path);\n    }\n  },\n  methods: {\n    navigateTo(route) {\n      if (this.$route.path !== route) {\n        this.$router.push(route);\n      }\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/login');\n    },\n    goToHomePage() {\n      if (this.$route.path !== '/') {\n        this.$router.push('/');\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","isLoggedIn","localStorage","getItem","computed","showAuthButtons","includes","$route","path","methods","navigateTo","route","$router","push","logout","removeItem","goToHomePage"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <header>\n      <h1 @click=\"goToHomePage\">旅游网站</h1>\n      <div class=\"auth-buttons\" v-if=\"showAuthButtons\">\n        <button @click=\"navigateTo('/login')\">登录</button>\n        <button @click=\"navigateTo('/register')\">注册</button>\n        <button @click=\"logout\" v-if=\"isLoggedIn\">注销</button>\n      </div>\n    </header>\n    <main>\n      <router-view></router-view>\n    </main>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      isLoggedIn: !!localStorage.getItem('token')\n    };\n  },\n  computed: {\n    showAuthButtons() {\n      // 不在登录和注册页面显示按钮\n      return !['/login', '/register'].includes(this.$route.path);\n    }\n  },\n  methods: {\n    navigateTo(route) {\n      if (this.$route.path !== route) {\n        this.$router.push(route);\n      }\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/login');\n    },\n    goToHomePage() {\n      if (this.$route.path !== '/') {\n        this.$router.push('/');\n      }\n    }\n  }\n}\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\nheader {\n  background-color: #42b983;\n  padding: 20px;\n  color: white;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.auth-buttons {\n  display: flex;\n  gap: 10px;\n}\n.auth-buttons button {\n  padding: 10px 20px;\n  border: none;\n  border-radius: 5px;\n  cursor: pointer;\n}\n.auth-buttons button:hover {\n  background-color: #2c3e50;\n  color: white;\n}\n</style>\n"],"mappings":";AAiBA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,UAAA,IAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,gBAAA;MACA;MACA,gCAAAC,QAAA,MAAAC,MAAA,CAAAC,IAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAAC,KAAA;MACA,SAAAJ,MAAA,CAAAC,IAAA,KAAAG,KAAA;QACA,KAAAC,OAAA,CAAAC,IAAA,CAAAF,KAAA;MACA;IACA;IACAG,OAAA;MACAZ,YAAA,CAAAa,UAAA;MACA,KAAAd,UAAA;MACA,KAAAW,OAAA,CAAAC,IAAA;IACA;IACAG,aAAA;MACA,SAAAT,MAAA,CAAAC,IAAA;QACA,KAAAI,OAAA,CAAAC,IAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}