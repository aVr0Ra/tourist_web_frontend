{"ast":null,"code":"export default {\n  name: 'DestinationCard',\n  props: {\n    image: String,\n    // 直接使用传入的图片URL\n    title: String,\n    description: String\n  },\n  computed: {\n    shortDescription() {\n      if (this.description.length > 150) {\n        return this.description.substr(0, 150);\n      } else {\n        return this.description;\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","image","String","title","description","computed","shortDescription","length","substr"],"sources":["src/components/DestinationCard.vue"],"sourcesContent":["<template>\r\n  <div class=\"destination-card\">\r\n    <img :src=\"image\" :alt=\"title\" class=\"destination-image\">\r\n    <div class=\"destination-info\">\r\n      <h3>{{ title }}</h3>\r\n      <p class=\"description\"> {{ shortDescription }} </p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'DestinationCard',\r\n  props: {\r\n    image: String, // 直接使用传入的图片URL\r\n    title: String,\r\n    description: String\r\n  },\r\n  computed: {\r\n    shortDescription() {\r\n      if (this.description.length > 150) {\r\n        return this.description.substr(0, 150);\r\n      }\r\n      else {\r\n        return this.description;\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.destination-card {\r\n  width: 30%; /* Adjusted for 3 columns layout */\r\n  margin: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\r\n}\r\n.destination-image {\r\n  width: 100%;\r\n  height: 200px; /* Adjusted height */\r\n  object-fit: cover;\r\n}\r\n.destination-info {\r\n  padding: 10px;\r\n  text-align: center;\r\n}\r\nh3 {\r\n  margin: 10px 0;\r\n}\r\n.description {\r\n  height: 60px; /* Adjusted height */\r\n  overflow: hidden;\r\n  /*text-overflow: ellipsis;*/\r\n  display: -webkit-box;\r\n  -webkit-box-orient: vertical;\r\n  -webkit-line-clamp: 2; /* Increased line clamp */\r\n}\r\n</style>\r\n"],"mappings":"AAWA;EACAA,IAAA;EACAC,KAAA;IACAC,KAAA,EAAAC,MAAA;IAAA;IACAC,KAAA,EAAAD,MAAA;IACAE,WAAA,EAAAF;EACA;EACAG,QAAA;IACAC,iBAAA;MACA,SAAAF,WAAA,CAAAG,MAAA;QACA,YAAAH,WAAA,CAAAI,MAAA;MACA,OACA;QACA,YAAAJ,WAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}