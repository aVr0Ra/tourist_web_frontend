{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      isLoggedIn: false,\n      showDropdown: false,\n      avatar: ''\n    };\n  },\n  computed: {\n    fullAvatarUrl() {\n      return this.avatar ? `http://127.0.0.1:8000${this.avatar}` : '';\n    }\n  },\n  created() {\n    this.checkLoginStatus();\n  },\n  methods: {\n    checkLoginStatus() {\n      const token = localStorage.getItem('token');\n      if (token) {\n        this.isLoggedIn = true;\n        this.fetchProfile();\n      }\n    },\n    async fetchProfile() {\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.avatar = response.data.avatar;\n      } catch (error) {\n        console.error('获取个人资料失败:', error);\n      }\n    },\n    toggleDropdown() {\n      this.showDropdown = !this.showDropdown;\n    },\n    hideDropdown() {\n      this.showDropdown = false;\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isLoggedIn","showDropdown","avatar","computed","fullAvatarUrl","created","checkLoginStatus","methods","token","localStorage","getItem","fetchProfile","response","get","headers","error","console","toggleDropdown","hideDropdown","logout","removeItem","$router","push"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <nav>\n      <div class=\"navbar\">\n        <router-link to=\"/\" class=\"site-title\">旅游网站</router-link>\n        <div v-if=\"isLoggedIn\" class=\"user-menu\" @mouseleave=\"showDropdown = false\">\n          <img :src=\"fullAvatarUrl\" alt=\"Avatar\" class=\"avatar\" @mouseover=\"showDropdown = true\" @click=\"toggleDropdown\">\n          <div v-if=\"showDropdown\" class=\"dropdown\">\n            <router-link to=\"/profile\" @click.native=\"hideDropdown\">编辑个人资料</router-link>\n            <router-link to=\"/frequent-travelers\" @click.native=\"hideDropdown\">添加/修改常用联系人</router-link>\n            <router-link to=\"/favorites\" @click.native=\"hideDropdown\">收藏夹</router-link>\n            <button @click=\"logout\">注销</button>\n          </div>\n        </div>\n        <div v-else>\n          <router-link to=\"/login\">登录</router-link>\n          <router-link to=\"/register\">注册</router-link>\n        </div>\n      </div>\n    </nav>\n    <router-view/>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  data() {\n    return {\n      isLoggedIn: false,\n      showDropdown: false,\n      avatar: '',\n    };\n  },\n  computed: {\n    fullAvatarUrl() {\n      return this.avatar ? `http://127.0.0.1:8000${this.avatar}` : '';\n    }\n  },\n  created() {\n    this.checkLoginStatus();\n  },\n  methods: {\n    checkLoginStatus() {\n      const token = localStorage.getItem('token');\n      if (token) {\n        this.isLoggedIn = true;\n        this.fetchProfile();\n      }\n    },\n    async fetchProfile() {\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.avatar = response.data.avatar;\n      } catch (error) {\n        console.error('获取个人资料失败:', error);\n      }\n    },\n    toggleDropdown() {\n      this.showDropdown = !this.showDropdown;\n    },\n    hideDropdown() {\n      this.showDropdown = false;\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/');\n    }\n  }\n}\n</script>\n\n<style scoped>\n.navbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px;\n  background-color: #42b983; /* 绿色背景 */\n}\n\n.site-title {\n  font-size: 2em;\n  color: white; /* 白色字体 */\n  text-decoration: none;\n}\n\n.user-menu {\n  position: relative;\n}\n\n.avatar {\n  width: 50px;\n  height: 50px;\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n.dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  background-color: white;\n  border: 1px solid #ccc;\n  border-radius: 5px;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);\n  padding: 10px;\n  white-space: nowrap; /* 保持选项在一行 */\n}\n\n.dropdown a,\n.dropdown button {\n  display: block;\n  padding: 10px;\n  text-decoration: none;\n  color: black;\n}\n\n.dropdown button {\n  border: none;\n  background: none;\n  cursor: pointer;\n  width: 100%;\n  text-align: left;\n}\n\n.dropdown a:hover,\n.dropdown button:hover {\n  background-color: #f0f0f0;\n}\n</style>\n"],"mappings":";AAyBA,OAAAA,KAAA;AAEA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,YAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACAC,cAAA;MACA,YAAAF,MAAA,gCAAAA,MAAA;IACA;EACA;EACAG,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACAD,iBAAA;MACA,MAAAE,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,IAAAF,KAAA;QACA,KAAAR,UAAA;QACA,KAAAW,YAAA;MACA;IACA;IACA,MAAAA,aAAA;MACA,MAAAH,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAE,QAAA,SAAAd,KAAA,CAAAe,GAAA;UACAC,OAAA;YACA,0BAAAN,KAAA;UACA;QACA;QACA,KAAAN,MAAA,GAAAU,QAAA,CAAAb,IAAA,CAAAG,MAAA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACAE,eAAA;MACA,KAAAhB,YAAA,SAAAA,YAAA;IACA;IACAiB,aAAA;MACA,KAAAjB,YAAA;IACA;IACAkB,OAAA;MACAV,YAAA,CAAAW,UAAA;MACA,KAAApB,UAAA;MACA,KAAAqB,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}