{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'LoginPage',\n  data() {\n    return {\n      username: '',\n      password: ''\n    };\n  },\n  methods: {\n    async login() {\n      const payload = {\n        username: this.username,\n        password: this.password\n      };\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/login/', payload, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        console.log('登录成功:', response.data);\n        // 保存 token 到本地存储，或者 Vuex 状态管理\n        localStorage.setItem('token', response.data.token);\n        // 跳转到主页或其他受保护的页面\n        this.$router.push('/');\n      } catch (error) {\n        if (error.response) {\n          console.error('登录失败:', error.response.data);\n          // 显示错误消息\n          alert(`登录失败: ${JSON.stringify(error.response.data)}`);\n        } else {\n          console.error('登录失败:', error.message);\n          alert(`登录失败: ${error.message}`);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","username","password","methods","login","payload","response","post","headers","console","log","localStorage","setItem","token","$router","push","error","alert","JSON","stringify","message"],"sources":["src/components/LoginPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"auth-page\">\r\n    <h2>登录</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"username\">用户名:</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">密码:</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required>\r\n      </div>\r\n      <button type=\"submit\">登录</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: ''\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      const payload = {\r\n        username: this.username,\r\n        password: this.password\r\n      };\r\n\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/login/', payload, {\r\n          headers: {\r\n            'Content-Type': 'application/json'\r\n          }\r\n        });\r\n        console.log('登录成功:', response.data);\r\n        // 保存 token 到本地存储，或者 Vuex 状态管理\r\n        localStorage.setItem('token', response.data.token);\r\n        // 跳转到主页或其他受保护的页面\r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        if (error.response) {\r\n          console.error('登录失败:', error.response.data);\r\n          // 显示错误消息\r\n          alert(`登录失败: ${JSON.stringify(error.response.data)}`);\r\n        } else {\r\n          console.error('登录失败:', error.message);\r\n          alert(`登录失败: ${error.message}`);\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.auth-page {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\nform div {\r\n  margin-bottom: 15px;\r\n}\r\nform label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\nform input {\r\n  width: 100%;\r\n  padding: 8px;\r\n  box-sizing: border-box;\r\n}\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\nbutton:hover {\r\n  background-color: #42b983;\r\n  color: white;\r\n}\r\n</style>\r\n"],"mappings":";AAkBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,MAAA;MACA,MAAAC,OAAA;QACAJ,QAAA,OAAAA,QAAA;QACAC,QAAA,OAAAA;MACA;MAEA;QACA,MAAAI,QAAA,SAAAR,KAAA,CAAAS,IAAA,qCAAAF,OAAA;UACAG,OAAA;YACA;UACA;QACA;QACAC,OAAA,CAAAC,GAAA,UAAAJ,QAAA,CAAAN,IAAA;QACA;QACAW,YAAA,CAAAC,OAAA,UAAAN,QAAA,CAAAN,IAAA,CAAAa,KAAA;QACA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,SAAAC,KAAA;QACA,IAAAA,KAAA,CAAAV,QAAA;UACAG,OAAA,CAAAO,KAAA,UAAAA,KAAA,CAAAV,QAAA,CAAAN,IAAA;UACA;UACAiB,KAAA,UAAAC,IAAA,CAAAC,SAAA,CAAAH,KAAA,CAAAV,QAAA,CAAAN,IAAA;QACA;UACAS,OAAA,CAAAO,KAAA,UAAAA,KAAA,CAAAI,OAAA;UACAH,KAAA,UAAAD,KAAA,CAAAI,OAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}