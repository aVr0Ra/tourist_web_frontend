{"ast":null,"code":"export default {\n  data() {\n    return {\n      username: '',\n      password: ''\n    };\n  },\n  methods: {\n    login() {\n      // 登录逻辑\n      console.log('Logging in with', this.username, this.password);\n    }\n  }\n};","map":{"version":3,"names":["data","username","password","methods","login","console","log"],"sources":["src/components/Register.vue"],"sourcesContent":["<template>\r\n  <div class=\"auth-page\">\r\n    <h2>登录</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"username\">用户名:</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required>\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">密码:</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required>\r\n      </div>\r\n      <button type=\"submit\">登录</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: ''\r\n    };\r\n  },\r\n  methods: {\r\n    login() {\r\n      // 登录逻辑\r\n      console.log('Logging in with', this.username, this.password);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.auth-page {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\nform div {\r\n  margin-bottom: 15px;\r\n}\r\nform label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\nform input {\r\n  width: 100%;\r\n  padding: 8px;\r\n  box-sizing: border-box;\r\n}\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\nbutton:hover {\r\n  background-color: #42b983;\r\n  color: white;\r\n}\r\n</style>\r\n"],"mappings":"AAkBA;EACAA,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACAC,MAAA;MACA;MACAC,OAAA,CAAAC,GAAA,yBAAAL,QAAA,OAAAC,QAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}