{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n      isLoggedIn: !!localStorage.getItem('token')\n    };\n  },\n  computed: {\n    showSearchBar() {\n      return this.$route.path !== '/login' && this.$route.path !== '/register';\n    }\n  },\n  methods: {\n    goHome() {\n      if (this.$route.path !== '/') {\n        this.$router.push('/');\n      }\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/').catch(err => {\n        if (err.name !== 'NavigationDuplicated') {\n          throw err;\n        }\n      });\n    },\n    searchAttractions() {\n      this.$router.push({\n        name: 'SearchResults',\n        query: {\n          q: this.searchQuery\n        }\n      });\n    },\n    updateAuthStatus() {\n      this.isLoggedIn = !!localStorage.getItem('token');\n    }\n  }\n};","map":{"version":3,"names":["data","searchQuery","isLoggedIn","localStorage","getItem","computed","showSearchBar","$route","path","methods","goHome","$router","push","logout","removeItem","catch","err","name","searchAttractions","query","q","updateAuthStatus"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <nav>\n      <div class=\"logo\" @click=\"goHome\">\n        旅游网站\n      </div>\n      <div class=\"auth\">\n        <div v-if=\"!isLoggedIn\">\n          <router-link to=\"/login\">登录</router-link>\n          <router-link to=\"/register\">注册</router-link>\n        </div>\n        <div v-else>\n          <button @click=\"logout\">注销</button>\n        </div>\n      </div>\n    </nav>\n    <div v-if=\"showSearchBar\" class=\"search-bar\">\n      <input type=\"text\" v-model=\"searchQuery\" placeholder=\"搜索景点...\" @keyup.enter=\"searchAttractions\">\n    </div>\n    <router-view @login=\"updateAuthStatus\"/>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n      isLoggedIn: !!localStorage.getItem('token')\n    };\n  },\n  computed: {\n    showSearchBar() {\n      return this.$route.path !== '/login' && this.$route.path !== '/register';\n    }\n  },\n  methods: {\n    goHome() {\n      if (this.$route.path !== '/') {\n        this.$router.push('/');\n      }\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/').catch(err => {\n        if (err.name !== 'NavigationDuplicated') {\n          throw err;\n        }\n      });\n    },\n    searchAttractions() {\n      this.$router.push({ name: 'SearchResults', query: { q: this.searchQuery } });\n    },\n    updateAuthStatus() {\n      this.isLoggedIn = !!localStorage.getItem('token');\n    }\n  }\n}\n</script>\n\n<style>\n#app nav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px; /* 增加纵向长度 */\n  background-color: #42b983;\n  color: white;\n}\n\n#app nav .logo {\n  flex: 1;\n  font-size: 2em; /* 增加字号 */\n  cursor: pointer;\n}\n\n#app nav .auth {\n  display: flex;\n  gap: 10px;\n}\n\n#app nav a, #app nav button {\n  color: white;\n  text-decoration: none;\n  margin-left: 10px;\n  padding: 5px 10px;\n  border: 1px solid white;\n  border-radius: 5px;\n  background-color: #42b983;\n  cursor: pointer;\n}\n\n#app nav a:hover, #app nav button:hover {\n  background-color: white;\n  color: #42b983;\n}\n\n.search-bar {\n  display: flex;\n  justify-content: center;\n  padding: 10px;\n  background-color: #f5f5f5;\n}\n\n.search-bar input {\n  width: 50%;\n  padding: 10px;\n  font-size: 16px;\n  border: 1px solid #ccc;\n  border-radius: 5px;\n}\n</style>\n"],"mappings":";AAwBA;EACAA,KAAA;IACA;MACAC,WAAA;MACAC,UAAA,IAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,cAAA;MACA,YAAAC,MAAA,CAAAC,IAAA,sBAAAD,MAAA,CAAAC,IAAA;IACA;EACA;EACAC,OAAA;IACAC,OAAA;MACA,SAAAH,MAAA,CAAAC,IAAA;QACA,KAAAG,OAAA,CAAAC,IAAA;MACA;IACA;IACAC,OAAA;MACAV,YAAA,CAAAW,UAAA;MACA,KAAAZ,UAAA;MA