{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'AttractionDetail',\n  data() {\n    return {\n      attraction: null,\n      comments: [],\n      newComment: ''\n    };\n  },\n  created() {\n    this.fetchAttractionDetails();\n  },\n  methods: {\n    async fetchAttractionDetails() {\n      const attractionId = this.$route.params.id;\n      try {\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}`);\n        this.attraction = response.data;\n      } catch (error) {\n        console.error('获取景点详情失败:', error);\n      }\n    },\n    async postComment() {\n      if (!this.newComment) {\n        return;\n      }\n      // 这里应该添加调用发表评论API的代码\n      // 例如：\n      // const response = await axios.post(`http://127.0.0.1:8000/api/attractions/${this.$route.params.id}/comments`, { text: this.newComment });\n      // this.comments.push(response.data);\n      this.comments.push({\n        id: this.comments.length + 1,\n        text: this.newComment\n      });\n      this.newComment = '';\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","attraction","comments","newComment","created","fetchAttractionDetails","methods","attractionId","$route","params","id","response","get","error","console","postComment","push","length","text"],"sources":["src/components/AttractionDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"attraction-detail\">\r\n    <h1>{{ attraction.name }}</h1>\r\n    <img :src=\"attraction.images[0].image\" :alt=\"attraction.name\" class=\"attraction-image\">\r\n    <p><strong>星级:</strong> {{ attraction.star_level }}</p>\r\n    <p><strong>评分:</strong> {{ attraction.rating }}</p>\r\n    <p><strong>描述:</strong> {{ attraction.description }}</p>\r\n    <p><strong>开放时间:</strong> {{ attraction.opening_hours }}</p>\r\n    <p><strong>地址:</strong> {{ attraction.address }}</p>\r\n    <p><strong>联系电话:</strong> {{ attraction.official_phone }}</p>\r\n    <p><strong>人气:</strong> {{ attraction.popularity }}</p>\r\n    <p><strong>评论数:</strong> {{ attraction.comment_count }}</p>\r\n\r\n    <div class=\"comments\">\r\n      <h2>评论区</h2>\r\n      <textarea v-model=\"newComment\" placeholder=\"发表评论\"></textarea>\r\n      <button @click=\"postComment\">提交评论</button>\r\n      <ul>\r\n        <li v-for=\"comment in comments\" :key=\"comment.id\">{{ comment.text }}</li>\r\n      </ul>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'AttractionDetail',\r\n  data() {\r\n    return {\r\n      attraction: null,\r\n      comments: [],\r\n      newComment: ''\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAttractionDetails();\r\n  },\r\n  methods: {\r\n    async fetchAttractionDetails() {\r\n      const attractionId = this.$route.params.id;\r\n      try {\r\n        const response = await axios.get(`http://127.0.0.1:8000/api/attractions/${attractionId}`);\r\n        this.attraction = response.data;\r\n      } catch (error) {\r\n        console.error('获取景点详情失败:', error);\r\n      }\r\n    },\r\n    async postComment() {\r\n      if (!this.newComment) {\r\n        return;\r\n      }\r\n      // 这里应该添加调用发表评论API的代码\r\n      // 例如：\r\n      // const response = await axios.post(`http://127.0.0.1:8000/api/attractions/${this.$route.params.id}/comments`, { text: this.newComment });\r\n      // this.comments.push(response.data);\r\n      this.comments.push({ id: this.comments.length + 1, text: this.newComment });\r\n      this.newComment = '';\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.attraction-detail {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n.attraction-image {\r\n  width: 100%;\r\n  height: auto;\r\n}\r\n.comments {\r\n  margin-top: 20px;\r\n}\r\n.comments textarea {\r\n  width: 100%;\r\n  height: 100px;\r\n}\r\n.comments button {\r\n  margin-top: 10px;\r\n}\r\n.comments ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n.comments li {\r\n  background: #f9f9f9;\r\n  margin: 5px 0;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n}\r\n</style>\r\n"],"mappings":";AAyBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,QAAA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,sBAAA;EACA;EACAC,OAAA;IACA,MAAAD,uBAAA;MACA,MAAAE,YAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA;QACA,MAAAC,QAAA,SAAAb,KAAA,CAAAc,GAAA,0CAAAL,YAAA;QACA,KAAAN,UAAA,GAAAU,QAAA,CAAAX,IAAA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAE,YAAA;MACA,UAAAZ,UAAA;QACA;MACA;MACA;MACA;MACA;MACA;MACA,KAAAD,QAAA,CAAAc,IAAA;QAAAN,EAAA,OAAAR,QAAA,CAAAe,MAAA;QAAAC,IAAA,OAAAf;MAAA;MACA,KAAAA,UAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}