{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'RouteManagementPage',\n  data() {\n    return {\n      routes: [],\n      currentPage: 1,\n      itemsPerPage: 5\n    };\n  },\n  computed: {\n    paginatedRoutes() {\n      const start = (this.currentPage - 1) * this.itemsPerPage;\n      const end = start + this.itemsPerPage;\n      return this.routes.slice(start, end);\n    },\n    totalPages() {\n      return Math.ceil(this.routes.length / this.itemsPerPage);\n    }\n  },\n  created() {\n    this.fetchRoutes();\n  },\n  methods: {\n    async fetchRoutes() {\n      const token = localStorage.getItem('token');\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/routes/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.routes = response.data;\n      } catch (error) {\n        console.error('获取线路失败:', error);\n      }\n    },\n    goToRouteDetails(routeId) {\n      this.$router.push({\n        name: 'RouteDetails',\n        params: {\n          routeId\n        }\n      });\n    },\n    prevPage() {\n      if (this.currentPage > 1) {\n        this.currentPage--;\n      }\n    },\n    nextPage() {\n      if (this.currentPage < this.totalPages) {\n        this.currentPage++;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","routes","currentPage","itemsPerPage","computed","paginatedRoutes","start","end","slice","totalPages","Math","ceil","length","created","fetchRoutes","methods","token","localStorage","getItem","response","get","headers","error","console","goToRouteDetails","routeId","$router","push","params","prevPage","nextPage"],"sources":["src/components/RouteManagementPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"route-management-page\">\r\n    <h1>管理线路及预约</h1>\r\n    <div v-for=\"route in paginatedRoutes\" :key=\"route.id\" class=\"route-card\" @click=\"goToRouteDetails(route.id)\">\r\n      <h2>{{ route.rt_name }}</h2>\r\n      <p>{{ route.rt_brief }}</p>\r\n      <div>\r\n        <span>经过景点：</span>\r\n        <span v-for=\"attraction in route.attractions\" :key=\"attraction.id\">{{ attraction.name }}</span>\r\n      </div>\r\n    </div>\r\n    <div class=\"pagination\">\r\n      <button @click=\"prevPage\" :disabled=\"currentPage === 1\">上一页</button>\r\n      <span>第 {{ currentPage }} 页，共 {{ totalPages }} 页</span>\r\n      <button @click=\"nextPage\" :disabled=\"currentPage === totalPages\">下一页</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'RouteManagementPage',\r\n  data() {\r\n    return {\r\n      routes: [],\r\n      currentPage: 1,\r\n      itemsPerPage: 5\r\n    };\r\n  },\r\n  computed: {\r\n    paginatedRoutes() {\r\n      const start = (this.currentPage - 1) * this.itemsPerPage;\r\n      const end = start + this.itemsPerPage;\r\n      return this.routes.slice(start, end);\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.routes.length / this.itemsPerPage);\r\n    }\r\n  },\r\n  created() {\r\n    this.fetchRoutes();\r\n  },\r\n  methods: {\r\n    async fetchRoutes() {\r\n      const token = localStorage.getItem('token');\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/routes/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.routes = response.data;\r\n      } catch (error) {\r\n        console.error('获取线路失败:', error);\r\n      }\r\n    },\r\n    goToRouteDetails(routeId) {\r\n      this.$router.push({ name: 'RouteDetails', params: { routeId } });\r\n    },\r\n    prevPage() {\r\n      if (this.currentPage > 1) {\r\n        this.currentPage--;\r\n      }\r\n    },\r\n    nextPage() {\r\n      if (this.currentPage < this.totalPages) {\r\n        this.currentPage++;\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.route-management-page {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.route-card {\r\n  background: #f9f9f9;\r\n  margin: 20px 0;\r\n  padding: 20px;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.route-card:hover {\r\n  background: #e9e9e9;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 20px;\r\n}\r\n\r\n.pagination button {\r\n  padding: 5px 10px;\r\n  font-size: 1em;\r\n}\r\n</style>\r\n"],"mappings":";AAoBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACAC,gBAAA;MACA,MAAAC,KAAA,SAAAJ,WAAA,aAAAC,YAAA;MACA,MAAAI,GAAA,GAAAD,KAAA,QAAAH,YAAA;MACA,YAAAF,MAAA,CAAAO,KAAA,CAAAF,KAAA,EAAAC,GAAA;IACA;IACAE,WAAA;MACA,OAAAC,IAAA,CAAAC,IAAA,MAAAV,MAAA,CAAAW,MAAA,QAAAT,YAAA;IACA;EACA;EACAU,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACA,MAAAD,YAAA;MACA,MAAAE,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA;QACA,MAAAC,QAAA,SAAArB,KAAA,CAAAsB,GAAA;UACAC,OAAA;YACA,0BAAAL,KAAA;UACA;QACA;QACA,KAAAf,MAAA,GAAAkB,QAAA,CAAAnB,IAAA;MACA,SAAAsB,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,iBAAAC,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;QAAA5B,IAAA;QAAA6B,MAAA;UAAAH;QAAA;MAAA;IACA;IACAI,SAAA;MACA,SAAA3B,WAAA;QACA,KAAAA,WAAA;MACA;IACA;IACA4B,SAAA;MACA,SAAA5B,WAAA,QAAAO,UAAA;QACA,KAAAP,WAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}