{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n      isLoggedIn: !!localStorage.getItem('token')\n    };\n  },\n  computed: {\n    showSearchBar() {\n      return this.$route.path !== '/login' && this.$route.path !== '/register';\n    }\n  },\n  methods: {\n    goHome() {\n      if (this.$route.path !== '/') {\n        this.$router.push('/');\n      }\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.isLoggedIn = false;\n      this.$router.push('/').catch(err => {\n        if (err.name !== 'NavigationDuplicated') {\n          throw err;\n        }\n      });\n    },\n    searchAttractions() {\n      this.$router.push({\n        name: 'SearchResults',\n        query: {\n          q: this.searchQuery\n        }\n      });\n    },\n    updateAuthStatus() {\n      this.isLoggedIn = !!localStorage.getItem('token');\n    }\n  }\n};","map":{"version":3,"names":["data","searchQuery","isLoggedIn","localStorage","getItem","computed","showSearchBar","$route","path","methods","goHome","$router","push","logout","removeItem","catch","err","name","searchAttractions","query","q","updateAuthStatus"],"sources":["src/components/AttractionDetail.vue"],"sourcesContent":["<template>\r\n  <div id=\"app\">\r\n    <nav>\r\n      <div class=\"logo\" @click=\"goHome\">\r\n        旅游网站\r\n      </div>\r\n      <div class=\"auth\">\r\n        <div v-if=\"!isLoggedIn\">\r\n          <router-link to=\"/login\">登录</router-link>\r\n          <router-link to=\"/register\">注册</router-link>\r\n        </div>\r\n        <div v-else>\r\n          <button @click=\"logout\">注销</button>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n    <div v-if=\"showSearchBar\" class=\"search-bar\">\r\n      <input type=\"text\" v-model=\"searchQuery\" placeholder=\"搜索景点...\" @keyup.enter=\"searchAttractions\">\r\n    </div>\r\n    <router-view @login=\"updateAuthStatus\"/>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      searchQuery: '',\r\n      isLoggedIn: !!localStorage.getItem('token')\r\n    };\r\n  },\r\n  computed: {\r\n    showSearchBar() {\r\n      return this.$route.path !== '/login' && this.$route.path !== '/register';\r\n    }\r\n  },\r\n  methods: {\r\n    goHome() {\r\n      if (this.$route.path !== '/') {\r\n        this.$router.push('/');\r\n      }\r\n    },\r\n    logout() {\r\n      localStorage.removeItem('token');\r\n      this.isLoggedIn = false;\r\n      this.$router.push('/').catch(err => {\r\n        if (err.name !== 'NavigationDuplicated') {\r\n          throw err;\r\n        }\r\n      });\r\n    },\r\n    searchAttractions() {\r\n      this.$router.push({ name: 'SearchResults', query: { q: this.searchQuery } });\r\n    },\r\n    updateAuthStatus() {\r\n      this.isLoggedIn = !!localStorage.getItem('token');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style>\r\n#app nav {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 20px; /* 增加纵向长度 */\r\n  background-color: #42b983;\r\n  color: white;\r\n}\r\n\r\n#app nav .logo {\r\n  flex: 1;\r\n  font-size: 2em; /* 增加字号 */\r\n  cursor: pointer;\r\n}\r\n\r\n#app nav .auth {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n#app nav a, #app nav button {\r\n  color: white;\r\n  text-decoration: none;\r\n  margin-left: 10px;\r\n  padding: 5px 10px;\r\n  border: 1px solid white;\r\n  border-radius: 5px;\r\n  background-color: #42b983;\r\n  cursor: pointer;\r\n}\r\n\r\n#app nav a:hover, #app nav button:hover {\r\n  background-color: white;\r\n  color: #42b983;\r\n}\r\n\r\n.search-bar {\r\n  display: flex;\r\n  justify-content: center;\r\n  padding: 10px;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.search-bar input {\r\n  width: 50%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n}\r\n</style>\r\n"],"mappings":";AAwBA;EACAA,KAAA;IACA;MACAC,WAAA;MACAC,UAAA,I