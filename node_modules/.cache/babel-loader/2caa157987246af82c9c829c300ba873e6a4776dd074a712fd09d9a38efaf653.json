{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'MyReservations',\n  data() {\n    return {\n      reservations: []\n    };\n  },\n  created() {\n    this.fetchReservations();\n  },\n  methods: {\n    async fetchReservations() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        const profileResponse = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        const userId = profileResponse.data.user.id;\n        const reservationsResponse = await axios.get(`http://127.0.0.1:8000/api/reservations/tourist/${userId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        const reservations = await Promise.all(reservationsResponse.data.map(async reservation => {\n          const routeResponse = await axios.get(`http://127.0.0.1:8000/api/routes/${reservation.rt_id}/`, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          const scheduleResponse = await axios.get(`http://127.0.0.1:8000/api/rt_rq/${reservation.rt_rq_id}/`, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          return {\n            ...reservation,\n            route: routeResponse.data,\n            schedule: scheduleResponse.data\n          };\n        }));\n        this.reservations = reservations;\n      } catch (error) {\n        console.error('获取预约信息失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","reservations","created","fetchReservations","methods","token","localStorage","getItem","alert","profileResponse","get","headers","userId","user","id","reservationsResponse","Promise","all","map","reservation","routeResponse","rt_id","scheduleResponse","rt_rq_id","route","schedule","error","console"],"sources":["src/components/MyReservations.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-reservations\">\r\n    <h1>我的预约</h1>\r\n    <div v-for=\"reservation in reservations\" :key=\"reservation.id\" class=\"reservation-card\">\r\n      <p><strong>预约日期:</strong> {{ reservation.rv_date }}</p>\r\n      <p><strong>线路名称:</strong> {{ reservation.route.rt_name }}</p>\r\n      <p><strong>线路简介:</strong> {{ reservation.route.rt_brief }}</p>\r\n      <p><strong>开始日期:</strong> {{ reservation.schedule.rq }}</p>\r\n      <p><strong>持续天数:</strong> {{ reservation.schedule.days }}</p>\r\n      <p><strong>人数上限:</strong> {{ reservation.schedule.limit }}</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'MyReservations',\r\n  data() {\r\n    return {\r\n      reservations: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchReservations();\r\n  },\r\n  methods: {\r\n    async fetchReservations() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const profileResponse = await axios.get('http://127.0.0.1:8000/api/profile/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        const userId = profileResponse.data.user.id;\r\n\r\n        const reservationsResponse = await axios.get(`http://127.0.0.1:8000/api/reservations/tourist/${userId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n\r\n        const reservations = await Promise.all(reservationsResponse.data.map(async (reservation) => {\r\n          const routeResponse = await axios.get(`http://127.0.0.1:8000/api/routes/${reservation.rt_id}/`, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n\r\n          const scheduleResponse = await axios.get(`http://127.0.0.1:8000/api/rt_rq/${reservation.rt_rq_id}/`, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n\r\n          return {\r\n            ...reservation,\r\n            route: routeResponse.data,\r\n            schedule: scheduleResponse.data\r\n          };\r\n        }));\r\n\r\n        this.reservations = reservations;\r\n      } catch (error) {\r\n        console.error('获取预约信息失败:', error);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-reservations {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.reservation-card {\r\n  background: #f9f9f9;\r\n  margin: 20px 0;\r\n  padding: 20px;\r\n  border-radius: 5px;\r\n  text-align: left;\r\n}\r\n\r\n.reservation-card p {\r\n  margin: 10px 0;\r\n}\r\n</style>\r\n"],"mappings":"AAeA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,iBAAA;EACA;EACAC,OAAA;IACA,MAAAD,kBAAA;MACA,MAAAE,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAG,KAAA;QACA;MACA;MAEA;QACA,MAAAC,eAAA,SAAAX,KAAA,CAAAY,GAAA;UACAC,OAAA;YACA,0BAAAN,KAAA;UACA;QACA;QACA,MAAAO,MAAA,GAAAH,eAAA,CAAAT,IAAA,CAAAa,IAAA,CAAAC,EAAA;QAEA,MAAAC,oBAAA,SAAAjB,KAAA,CAAAY,GAAA,mDAAAE,MAAA;UACAD,OAAA;YACA,0BAAAN,KAAA;UACA;QACA;QAEA,MAAAJ,YAAA,SAAAe,OAAA,CAAAC,GAAA,CAAAF,oBAAA,CAAAf,IAAA,CAAAkB,GAAA,OAAAC,WAAA;UACA,MAAAC,aAAA,SAAAtB,KAAA,CAAAY,GAAA,qCAAAS,WAAA,CAAAE,KAAA;YACAV,OAAA;cACA,0BAAAN,KAAA;YACA;UACA;UAEA,MAAAiB,gBAAA,SAAAxB,KAAA,CAAAY,GAAA,oCAAAS,WAAA,CAAAI,QAAA;YACAZ,OAAA;cACA,0BAAAN,KAAA;YACA;UACA;UAEA;YACA,GAAAc,WAAA;YACAK,KAAA,EAAAJ,aAAA,CAAApB,IAAA;YACAyB,QAAA,EAAAH,gBAAA,CAAAtB;UACA;QACA;QAEA,KAAAC,YAAA,GAAAA,YAAA;MACA,SAAAyB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}