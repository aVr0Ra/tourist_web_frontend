{"ast":null,"code":"export default {\n  name: 'App',\n  computed: {\n    showAuthButtons() {\n      return this.$route.path === '/';\n    }\n  }\n};","map":{"version":3,"names":["name","computed","showAuthButtons","$route","path"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <header>\n      <h1>旅游网站</h1>\n      <div class=\"auth-buttons\" v-if=\"showAuthButtons\">\n        <router-link to=\"/login\">\n          <button>登录</button>\n        </router-link>\n        <router-link to=\"/register\">\n          <button>注册</button>\n        </router-link>\n      </div>\n    </header>\n    <main>\n      <router-view></router-view>\n    </main>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  computed: {\n    showAuthButtons() {\n      return this.$route.path === '/';\n    }\n  }\n}\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\nheader {\n  background-color: #42b983;\n  padding: 20px;\n  color: white;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.auth-buttons {\n  display: flex;\n  gap: 10px;\n}\n.auth-buttons button {\n  padding: 10px 20px;\n  border: none;\n  border-radius: 5px;\n  cursor: pointer;\n}\n.auth-buttons button:hover {\n  background-color: #2c3e50;\n  color: white;\n}\n</style>\n"],"mappings":"AAoBA;EACAA,IAAA;EACAC,QAAA;IACAC,gBAAA;MACA,YAAAC,MAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}