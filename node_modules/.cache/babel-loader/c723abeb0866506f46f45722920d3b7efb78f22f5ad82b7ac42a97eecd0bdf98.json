{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nimport SearchBar from './components/SearchBar.vue';\nexport default {\n  components: {\n    SearchBar\n  },\n  data() {\n    return {\n      showDropdown: false,\n      userAvatar: '',\n      userType: ''\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    showSearchBar() {\n      const noSearchRoutes = ['/login', '/register', '/profile', '/frequent-travelers'];\n      return !noSearchRoutes.includes(this.$route.path);\n    }\n  },\n  created() {\n    this.fetchUserProfile();\n  },\n  methods: {\n    toggleDropdown() {\n      this.showDropdown = !this.showDropdown;\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.$router.push('/');\n      location.reload();\n    },\n    async fetchUserProfile() {\n      const token = localStorage.getItem('token');\n      if (!token) return;\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.userAvatar = `http://127.0.0.1:8000${response.data.avatar}`;\n        this.userType = response.data.user_type;\n      } catch (error) {\n        console.error('获取用户资料失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","SearchBar","components","data","showDropdown","userAvatar","userType","computed","isLoggedIn","localStorage","getItem","showSearchBar","noSearchRoutes","includes","$route","path","created","fetchUserProfile","methods","toggleDropdown","logout","removeItem","$router","push","location","reload","token","response","get","headers","avatar","user_type","error","console"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <header>\n      <router-link to=\"/\">旅游网站</router-link>\n      <div v-if=\"isLoggedIn\" class=\"dropdown\">\n        <img :src=\"userAvatar\" @click=\"toggleDropdown\" class=\"avatar\">\n        <div v-if=\"showDropdown\" class=\"dropdown-content\">\n          <router-link to=\"/profile\">编辑个人资料</router-link>\n          <router-link v-if=\"userType !== 'agent'\" to=\"/frequent-travelers\">添加/修改常用联系人</router-link>\n          <router-link to=\"/favorites\">收藏夹</router-link>\n          <button @click=\"logout\">注销</button>\n        </div>\n      </div>\n      <div v-else>\n        <router-link to=\"/login\">登录</router-link>\n        <router-link to=\"/register\">注册</router-link>\n      </div>\n    </header>\n    <search-bar v-if=\"showSearchBar\"></search-bar>\n    <router-view />\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\nimport SearchBar from './components/SearchBar.vue';\n\nexport default {\n  components: {\n    SearchBar\n  },\n  data() {\n    return {\n      showDropdown: false,\n      userAvatar: '',\n      userType: ''\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    showSearchBar() {\n      const noSearchRoutes = ['/login', '/register', '/profile', '/frequent-travelers'];\n      return !noSearchRoutes.includes(this.$route.path);\n    }\n  },\n  created() {\n    this.fetchUserProfile();\n  },\n  methods: {\n    toggleDropdown() {\n      this.showDropdown = !this.showDropdown;\n    },\n    logout() {\n      localStorage.removeItem('token');\n      this.$router.push('/');\n      location.reload();\n    },\n    async fetchUserProfile() {\n      const token = localStorage.getItem('token');\n      if (!token) return;\n      \n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/profile/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.userAvatar = `http://127.0.0.1:8000${response.data.avatar}`;\n        this.userType = response.data.user_type;\n      } catch (error) {\n        console.error('获取用户资料失败:', error);\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\nheader {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  background-color: #42b983;\n  color: white;\n}\n\nheader a {\n  color: white;\n  text-decoration: none;\n  margin-right: 20px;\n}\n\n.dropdown {\n  position: relative;\n}\n\n.avatar {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n.dropdown-content {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  background-color: white;\n  color: black;\n  min-width: 160px;\n  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);\n  z-index: 1;\n}\n\n.dropdown-content a, .dropdown-content button {\n  color: black;\n  padding: 12px 16px;\n  text-decoration: none;\n  display: block;\n  width: 100%;\n  text-align: left;\n  border: none;\n  background: none;\n}\n\n.dropdown-content a:hover, .dropdown-content button:hover {\n  background-color: #ddd;\n}\n</style>\n"],"mappings":";AAwBA,OAAAA,KAAA;AACA,OAAAC,SAAA;AAEA;EACAC,UAAA;IACAD;EACA;EACAE,KAAA;IACA;MACAC,YAAA;MACAC,UAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAC,YAAA,CAAAC,OAAA;IACA;IACAC,cAAA;MACA,MAAAC,cAAA;MACA,QAAAA,cAAA,CAAAC,QAAA,MAAAC,MAAA,CAAAC,IAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACAC,eAAA;MACA,KAAAf,YAAA,SAAAA,YAAA;IACA;IACAgB,OAAA;MACAX,YAAA,CAAAY,UAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;MACAC,QAAA,CAAAC,MAAA;IACA;IACA,MAAAR,iBAAA;MACA,MAAAS,KAAA,GAAAjB,YAAA,CAAAC,OAAA;MACA,KAAAgB,KAAA;MAEA;QACA,MAAAC,QAAA,SAAA3B,KAAA,CAAA4B,GAAA;UACAC,OAAA;YACA,0BAAAH,KAAA;UACA;QACA;QACA,KAAArB,UAAA,2BAAAsB,QAAA,CAAAxB,IAAA,CAAA2B,MAAA;QACA,KAAAxB,QAAA,GAAAqB,QAAA,CAAAxB,IAAA,CAAA4B,SAAA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}