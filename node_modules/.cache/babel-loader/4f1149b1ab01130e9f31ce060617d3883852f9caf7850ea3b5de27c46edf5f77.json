{"ast":null,"code":"import axios from 'axios';\nimport DestinationCard from './DestinationCard.vue';\nexport default {\n  name: 'FavoritesPage',\n  components: {\n    DestinationCard\n  },\n  data() {\n    return {\n      favorites: []\n    };\n  },\n  created() {\n    this.fetchFavorites();\n  },\n  methods: {\n    async fetchFavorites() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        const attractionsResponse = await axios.get('http://127.0.0.1:8000/api/attractions/');\n        const attractions = attractionsResponse.data;\n        this.favorites = response.data.map(favorite => ({\n          ...favorite,\n          attraction: attractions.find(attraction => attraction.id === favorite.attraction)\n        }));\n      } catch (error) {\n        console.error('获取收藏夹失败:', error);\n      }\n    },\n    async removeFavorite(favoriteId) {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      try {\n        await axios.delete(`http://127.0.0.1:8000/api/favorites/${favoriteId}/`, {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.favorites = this.favorites.filter(favorite => favorite.id !== favoriteId);\n      } catch (error) {\n        console.error('删除收藏失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","DestinationCard","name","components","data","favorites","created","fetchFavorites","methods","token","localStorage","getItem","alert","response","get","headers","attractionsResponse","attractions","map","favorite","attraction","find","id","error","console","removeFavorite","favoriteId","delete","filter"],"sources":["src/components/FavoritesPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"favorites-page\">\r\n    <h1>收藏夹</h1>\r\n    <div v-if=\"favorites.length === 0\">\r\n      <p>暂无收藏的景点</p>\r\n    </div>\r\n    <div v-else>\r\n      <div v-for=\"favorite in favorites\" :key=\"favorite.id\" class=\"favorite-item\">\r\n        <DestinationCard \r\n          :image=\"favorite.attraction.image\" \r\n          :title=\"favorite.attraction.title\" \r\n          :description=\"favorite.attraction.description\"\r\n          :attractionId=\"favorite.attraction.id\" />\r\n        <button @click=\"removeFavorite(favorite.id)\">取消收藏</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport DestinationCard from './DestinationCard.vue';\r\n\r\nexport default {\r\n  name: 'FavoritesPage',\r\n  components: {\r\n    DestinationCard\r\n  },\r\n  data() {\r\n    return {\r\n      favorites: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFavorites();\r\n  },\r\n  methods: {\r\n    async fetchFavorites() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n\r\n        const attractionsResponse = await axios.get('http://127.0.0.1:8000/api/attractions/');\r\n        const attractions = attractionsResponse.data;\r\n\r\n        this.favorites = response.data.map(favorite => ({\r\n          ...favorite,\r\n          attraction: attractions.find(attraction => attraction.id === favorite.attraction)\r\n        }));\r\n      } catch (error) {\r\n        console.error('获取收藏夹失败:', error);\r\n      }\r\n    },\r\n    async removeFavorite(favoriteId) {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        await axios.delete(`http://127.0.0.1:8000/api/favorites/${favoriteId}/`, {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.favorites = this.favorites.filter(favorite => favorite.id !== favoriteId);\r\n      } catch (error) {\r\n        console.error('删除收藏失败:', error);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.favorites-page {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.favorite-item {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  background-color: #d9534f;\r\n  color: white;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #c9302c;\r\n}\r\n</style>\r\n"],"mappings":"AAoBA,OAAAA,KAAA;AACA,OAAAC,eAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,KAAA;IACA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAD,eAAA;MACA,MAAAE,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAG,KAAA;QACA;MACA;MAEA;QACA,MAAAC,QAAA,SAAAb,KAAA,CAAAc,GAAA;UACAC,OAAA;YACA,0BAAAN,KAAA;UACA;QACA;QAEA,MAAAO,mBAAA,SAAAhB,KAAA,CAAAc,GAAA;QACA,MAAAG,WAAA,GAAAD,mBAAA,CAAAZ,IAAA;QAEA,KAAAC,SAAA,GAAAQ,QAAA,CAAAT,IAAA,CAAAc,GAAA,CAAAC,QAAA;UACA,GAAAA,QAAA;UACAC,UAAA,EAAAH,WAAA,CAAAI,IAAA,CAAAD,UAAA,IAAAA,UAAA,CAAAE,EAAA,KAAAH,QAAA,CAAAC,UAAA;QACA;MACA,SAAAG,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACA,MAAAE,eAAAC,UAAA;MACA,MAAAjB,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;QACAG,KAAA;QACA;MACA;MAEA;QACA,MAAAZ,KAAA,CAAA2B,MAAA,wCAAAD,UAAA;UACAX,OAAA;YACA,0BAAAN,KAAA;UACA;QACA;QACA,KAAAJ,SAAA,QAAAA,SAAA,CAAAuB,MAAA,CAAAT,QAAA,IAAAA,QAAA,CAAAG,EAAA,KAAAI,UAAA;MACA,SAAAH,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}