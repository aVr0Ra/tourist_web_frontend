{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'AddTravelRoute',\n  data() {\n    return {\n      routeName: '',\n      selectedAgencyId: null,\n      price: 0,\n      routeDescription: '',\n      agencies: []\n    };\n  },\n  created() {\n    this.fetchAgencies();\n  },\n  methods: {\n    async fetchAgencies() {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/agencies/');\n        this.agencies = response.data;\n      } catch (error) {\n        console.error('获取旅行公司信息失败:', error);\n      }\n    },\n    async submitRoute() {\n      const routeData = {\n        rt_name: this.routeName,\n        ag_id: this.selectedAgencyId,\n        price: this.price.toFixed(2),\n        rt_brief: this.routeDescription\n      };\n      try {\n        await axios.post('http://127.0.0.1:8000/api/routes/', routeData, {\n          headers: {\n            'Authorization': `Token ${localStorage.getItem('token')}`\n          }\n        });\n        alert('线路添加成功!');\n        this.$router.push('/'); // 添加成功后跳转到主页或其他页面\n      } catch (error) {\n        console.error('提交线路失败:', error);\n        alert('添加线路失败.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","routeName","selectedAgencyId","price","routeDescription","agencies","created","fetchAgencies","methods","response","get","error","console","submitRoute","routeData","rt_name","ag_id","toFixed","rt_brief","post","headers","localStorage","getItem","alert","$router","push"],"sources":["src/components/AddTravelRoute.vue"],"sourcesContent":["<template>\r\n  <div class=\"add-travel-route\">\r\n    <h1>添加旅游线路</h1>\r\n    <form @submit.prevent=\"submitRoute\">\r\n      <div class=\"form-group\">\r\n        <label for=\"routeName\">线路名称:</label>\r\n        <input id=\"routeName\" v-model=\"routeName\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"agency\">选择旅行公司:</label>\r\n        <select id=\"agency\" v-model=\"selectedAgencyId\" required>\r\n          <option v-for=\"agency in agencies\" :value=\"agency.id\" :key=\"agency.id\">\r\n            {{ agency.ag_name }}\r\n          </option>\r\n        </select>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"price\">价格:</label>\r\n        <input type=\"number\" id=\"price\" v-model=\"price\" required>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label for=\"description\">线路简介:</label>\r\n        <textarea id=\"description\" v-model=\"routeDescription\" required></textarea>\r\n      </div>\r\n      <button type=\"submit\">提交线路</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'AddTravelRoute',\r\n  data() {\r\n    return {\r\n      routeName: '',\r\n      selectedAgencyId: null,\r\n      price: 0,\r\n      routeDescription: '',\r\n      agencies: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAgencies();\r\n  },\r\n  methods: {\r\n    async fetchAgencies() {\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/agencies/');\r\n        this.agencies = response.data;\r\n      } catch (error) {\r\n        console.error('获取旅行公司信息失败:', error);\r\n      }\r\n    },\r\n    async submitRoute() {\r\n      const routeData = {\r\n        rt_name: this.routeName,\r\n        ag_id: this.selectedAgencyId,\r\n        price: this.price.toFixed(2),\r\n        rt_brief: this.routeDescription\r\n      };\r\n\r\n      try {\r\n        await axios.post('http://127.0.0.1:8000/api/routes/', routeData, {\r\n          headers: {\r\n            'Authorization': `Token ${localStorage.getItem('token')}`\r\n          }\r\n        });\r\n        alert('线路添加成功!');\r\n        this.$router.push('/'); // 添加成功后跳转到主页或其他页面\r\n      } catch (error) {\r\n        console.error('提交线路失败:', error);\r\n        alert('添加线路失败.');\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.add-travel-route form {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input, .form-group select, .form-group textarea {\r\n  width: 100%;\r\n  padding: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton {\r\n  background-color: #42b983;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #368f6a;\r\n}\r\n</style>\r\n"],"mappings":";AA8BA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,gBAAA;MACAC,KAAA;MACAC,gBAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAD,cAAA;MACA;QACA,MAAAE,QAAA,SAAAX,KAAA,CAAAY,GAAA;QACA,KAAAL,QAAA,GAAAI,QAAA,CAAAT,IAAA;MACA,SAAAW,KAAA;QACAC,OAAA,CAAAD,KAAA,gBAAAA,KAAA;MACA;IACA;IACA,MAAAE,YAAA;MACA,MAAAC,SAAA;QACAC,OAAA,OAAAd,SAAA;QACAe,KAAA,OAAAd,gBAAA;QACAC,KAAA,OAAAA,KAAA,CAAAc,OAAA;QACAC,QAAA,OAAAd;MACA;MAEA;QACA,MAAAN,KAAA,CAAAqB,IAAA,sCAAAL,SAAA;UACAM,OAAA;YACA,0BAAAC,YAAA,CAAAC,OAAA;UACA;QACA;QACAC,KAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,SAAAd,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACAY,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}