{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'DestinationCard',\n  props: {\n    image: String,\n    title: String,\n    description: String,\n    attractionId: Number\n  },\n  data() {\n    return {\n      isFavorite: false\n    };\n  },\n  created() {\n    this.checkIfFavorite();\n  },\n  methods: {\n    async checkIfFavorite() {\n      const token = localStorage.getItem('token');\n      if (!token) return;\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n          headers: {\n            'Authorization': `Token ${token}`\n          }\n        });\n        this.isFavorite = response.data.some(favorite => favorite.attraction === this.attractionId);\n      } catch (error) {\n        console.error('检查收藏状态失败:', error);\n      }\n    },\n    async toggleFavorite() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('请先登录');\n        return;\n      }\n      if (this.isFavorite) {\n        try {\n          const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          const favorite = response.data.find(fav => fav.attraction === this.attractionId);\n          if (favorite) {\n            await axios.delete(`http://127.0.0.1:8000/api/favorites/${favorite.id}/`, {\n              headers: {\n                'Authorization': `Token ${token}`\n              }\n            });\n            this.isFavorite = false;\n          }\n        } catch (error) {\n          console.error('取消收藏失败:', error);\n        }\n      } else {\n        try {\n          await axios.post('http://127.0.0.1:8000/api/favorites/', {\n            attraction: this.attractionId\n          }, {\n            headers: {\n              'Authorization': `Token ${token}`\n            }\n          });\n          this.isFavorite = true;\n        } catch (error) {\n          console.error('收藏失败:', error);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","props","image","String","title","description","attractionId","Number","data","isFavorite","created","checkIfFavorite","methods","token","localStorage","getItem","response","get","headers","some","favorite","attraction","error","console","toggleFavorite","alert","find","fav","delete","id","post"],"sources":["src/components/DestinationCard.vue"],"sourcesContent":["<template>\r\n  <div class=\"destination-card\">\r\n    <img :src=\"image\" :alt=\"title\" class=\"destination-image\">\r\n    <div class=\"destination-details\">\r\n      <h3>{{ title }}</h3>\r\n      <p>{{ description }}</p>\r\n      <button @click=\"toggleFavorite\">{{ isFavorite ? '取消收藏' : '收藏' }}</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'DestinationCard',\r\n  props: {\r\n    image: String,\r\n    title: String,\r\n    description: String,\r\n    attractionId: Number\r\n  },\r\n  data() {\r\n    return {\r\n      isFavorite: false\r\n    };\r\n  },\r\n  created() {\r\n    this.checkIfFavorite();\r\n  },\r\n  methods: {\r\n    async checkIfFavorite() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) return;\r\n\r\n      try {\r\n        const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n          headers: {\r\n            'Authorization': `Token ${token}`\r\n          }\r\n        });\r\n        this.isFavorite = response.data.some(favorite => favorite.attraction === this.attractionId);\r\n      } catch (error) {\r\n        console.error('检查收藏状态失败:', error);\r\n      }\r\n    },\r\n    async toggleFavorite() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('请先登录');\r\n        return;\r\n      }\r\n\r\n      if (this.isFavorite) {\r\n        try {\r\n          const response = await axios.get('http://127.0.0.1:8000/api/favorites/', {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n          const favorite = response.data.find(fav => fav.attraction === this.attractionId);\r\n          if (favorite) {\r\n            await axios.delete(`http://127.0.0.1:8000/api/favorites/${favorite.id}/`, {\r\n              headers: {\r\n                'Authorization': `Token ${token}`\r\n              }\r\n            });\r\n            this.isFavorite = false;\r\n          }\r\n        } catch (error) {\r\n          console.error('取消收藏失败:', error);\r\n        }\r\n      } else {\r\n        try {\r\n          await axios.post('http://127.0.0.1:8000/api/favorites/', { attraction: this.attractionId }, {\r\n            headers: {\r\n              'Authorization': `Token ${token}`\r\n            }\r\n          });\r\n          this.isFavorite = true;\r\n        } catch (error) {\r\n          console.error('收藏失败:', error);\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.destination-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  padding: 10px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 5px;\r\n  margin: 10px;\r\n}\r\n\r\n.destination-image {\r\n  width: 100%;\r\n  height: auto;\r\n  border-radius: 5px;\r\n}\r\n\r\n.destination-details {\r\n  text-align: center;\r\n}\r\n\r\nbutton {\r\n  padding: 10px 20px;\r\n  margin-top: 10px;\r\n  border: none;\r\n  border-radius: 5px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #359a6d;\r\n}\r\n</style>\r\n"],"mappings":"AAYA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,KAAA,EAAAC,MAAA;IACAC,KAAA,EAAAD,MAAA;IACAE,WAAA,EAAAF,MAAA;IACAG,YAAA,EAAAC;EACA;EACAC,KAAA;IACA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,eAAA;EACA;EACAC,OAAA;IACA,MAAAD,gBAAA;MACA,MAAAE,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,KAAAF,KAAA;MAEA;QACA,MAAAG,QAAA,SAAAjB,KAAA,CAA